{
  "format_version": 1,
  "commands": [
    {
      "id": "tab.next",
      "label": "Next Tab",
      "intent": "Go to the next tab."
    },
    {
      "id": "tab.prev",
      "label": "Previous Tab",
      "intent": "Go to the previous tab."
    },
    {
      "id": "tab.close",
      "label": "Close Tab",
      "intent": "Close the current tab.",
      "params": [
        {
          "name": "focus",
          "type": "enum",
          "values": [
            "right",
            "left"
          ],
          "default": "right",
          "main": true
        }
      ],
      "count": "repeat"
    },
    {
      "id": "tab.reopen_in_container",
      "label": "Reopen in Container",
      "intent": "Reopen the tab in a container.",
      "params": [
        {
          "name": "container",
          "type": "string",
          "values": {
            "from": "containers"
          },
          "main": true
        }
      ]
    },
    {
      "id": "open.url",
      "name": "open",
      "aliases": [
        "o"
      ],
      "label": "Open URL",
      "intent": "Open a URL.",
      "params": [
        {
          "name": "url",
          "type": "string",
          "main": true
        },
        {
          "name": "container",
          "type": "string",
          "values": {
            "from": "containers"
          },
          "when": {
            "where": [
              "tab",
              "background",
              "window"
            ]
          }
        },
        {
          "name": "where",
          "type": "enum",
          "values": [
            "here",
            "tab",
            "background",
            "window"
          ],
          "default": "here"
        }
      ]
    },
    {
      "id": "open.search",
      "name": "search",
      "aliases": [
        "s"
      ],
      "label": "Search",
      "intent": "Search with an engine.",
      "params": [
        {
          "name": "engine",
          "type": "enum",
          "values": {
            "from": "search_engines"
          }
        },
        {
          "name": "query",
          "type": "string",
          "default": {
            "from": "selection"
          },
          "main": true
        },
        {
          "name": "where",
          "type": "enum",
          "values": [
            "here",
            "tab",
            "background",
            "window"
          ],
          "default": "here"
        },
        {
          "name": "depth",
          "type": "int",
          "default": 1
        }
      ]
    }
  ]
}
