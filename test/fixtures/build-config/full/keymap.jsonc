// Main keymap. Comments and trailing commas are allowed.
{
  "search_keys": { "a": "alpha", "b": "beta" },
  "container_keys": { "x": "Work", "y": "Home", },
  "normal": {
    "J": { "id": "tab.next" },
    "K": { "id": "tab.prev" },
    "D": { "id": "tab.close", "args": { "focus": "left" } },
  },
  "browser": { "<A-j>": { "id": "tab.next" } }
}
