{
  "manifest_version": 2,
  "name": "key-spike",
  "version": "0.0.1",
  "browser_specific_settings": { "gecko": { "id": "key-spike@oasis-dots" } },
  "permissions": ["tabs", "nativeMessaging", "<all_urls>"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "match_about_blank": true
  }],
  "commands": {
    "tab_next": { "suggested_key": { "default": "Alt+J" }, "description": "next tab" },
    "tab_prev": { "suggested_key": { "default": "Alt+K" }, "description": "previous tab" }
  }
}
