#!/usr/bin/env python3
"""Native-messaging host for the DesertFox Firefox extension.

Firefox starts it for one request: a 4-byte native-endian length, then UTF-8 JSON, on stdin. The host writes one reply
in the same framing to stdout and exits. It has five verbs and no others:

  {"cmd": "read_config"}
      -> {"ok": true, "host_version": 1, "release_version": "0.1.22", "config_dir": "...", "config_dir_exists": true, "files": {"keymap.toml": "<text>", ...}}
  {"cmd": "write_autoconfig", "toml": "<text>"}
      -> {"ok": true, "host_version": 1, "release_version": "0.1.22", "path": "..."}
  {"cmd": "self_update", "version": "0.1.23", "sha256": {"desertfox-host": "<hex>", "desertfox-bridge": "<hex>", "desertfox": "<hex>"}}
      -> {"ok": true, "host_version": 1, "release_version": "0.1.22", "updated": true, "version": "0.1.23", "replaced": ["<path>", ...]}
  {"cmd": "editor_start", "text": "<text>", "ext": "md", "insert": true}
      -> {"ok": true, "host_version": 1, "release_version": "0.1.22", "job": "<32 hex digits>"}
  {"cmd": "editor_collect", "job": "<job from editor_start>"}
      -> {"ok": true, ..., "pending": true}  while the editor runs (after a wait of 20 s at most), or
         {"ok": true, ..., "done": true, "changed": true, "text": "<edited text>"}  (`text` only when `changed`)
  {"cmd": "open_firefox_page", "page": "settings"}
      -> {"ok": true, "host_version": 1, "release_version": "0.1.22", "page": "settings"}
  Any failure -> {"ok": false, "host_version": 1, "release_version": "0.1.22", "error": "..."}

The host reads the config folder (default ~/.config/desertfox, DESERTFOX_CONFIG_DIR overrides it) and writes exactly one
file there, autoconfig.toml. It never edits the user's own files, and it parses no config of the extension: the extension owns that TOML. Only editor.toml, which the extension never sees, is parsed here.
`self_update` replaces the installed hosts, the command line and their two manifests with a GitHub release (see
`self_update`). `editor_start` and `editor_collect` run the editor named in editor.toml (see `load_editor_config`), which no
reply ever carries. `open_firefox_page` asks the Firefox that started the host to open one page of a fixed table (see
`open_firefox_page`). Stdout carries only protocol bytes.
"""
import contextlib
import fcntl
import hashlib
import http.client
import io
import json
import os
import re
import secrets
import signal
import stat
import ssl
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

HOST_VERSION = 1
# `just release_stamp` replaces "dev" with the release version in the shipped copy only. A host that says "dev" runs from a
# checkout or the main branch, so it never updates itself.
RELEASE_VERSION = "dev"
MAX_CONFIG_FILE_BYTES = 1024 * 1024
# Firefox drops a host reply above 1 MiB, so the host refuses to send one and says why.
MAX_REPLY_BYTES = 1024 * 1024
# The request size is not limited by Firefox. The host stops reading a request this large, which only a bug would send.
MAX_REQUEST_BYTES = 4 * 1024 * 1024
AUTOCONFIG_NAME = "autoconfig.toml"
# The editor command. Only the host reads it, so read_config and the tool reader skip it: the extension never sees it.
EDITOR_CONFIG_NAME = "editor.toml"
AUTOCONFIG_HEADER = (
    "# Written by DesertFox from the edits saved in the browser. DesertFox never reads this file back.\n"
    "# Edits here are overwritten. Put your own settings in settings.toml.\n"
)

# The names the extension's config build knows (src/shared/config_build/source_files.ts). The reader below mirrors
# tools/build-config/source_files.ts: a file outside these places is reported by name only, with empty text.
KNOWN_FILES = {"keymap.toml", "search_engines.toml", "command_aliases.toml", "quickmarks.toml", "settings.toml", "style.css"}
KNOWN_DIRS = {"keymap.d", "search_engines.d", "command_aliases.d", "quickmarks.d", "settings.d", "snippets", "style.d", "themes"}


class HostError(Exception):
    """A failure the extension should see as a message."""


def config_dir():
    override = os.environ.get("DESERTFOX_CONFIG_DIR")
    if override:
        return override
    # A relative XDG_CONFIG_HOME is invalid by the XDG spec and ignored.
    config_home = os.environ.get("XDG_CONFIG_HOME", "")
    if not os.path.isabs(config_home):
        config_home = os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config_home, "desertfox")


def visible_entries(directory):
    return sorted(name for name in os.listdir(directory) if not name.startswith("."))


def read_text(path):
    """The text of a regular file of at most MAX_CONFIG_FILE_BYTES, or None for any other file.
    Opens without blocking and judges the open descriptor, so a FIFO swapped in after a check cannot hang the host."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as error:
        raise HostError(f"cannot read {path}: {error.strerror or error}") from error
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            return None
        with os.fdopen(descriptor, "rb", closefd=False) as file:
            raw = file.read(MAX_CONFIG_FILE_BYTES + 1)
    except OSError as error:
        raise HostError(f"cannot read {path}: {error.strerror or error}") from error
    finally:
        os.close(descriptor)
    return None if len(raw) > MAX_CONFIG_FILE_BYTES else raw.decode("utf-8", errors="replace")


def read_files(directory):
    """Raw text by path relative to `directory`. A folder entry is `<path>/` with empty text, as the tool reader makes it.
    A file the host will not read (not a regular file, or over MAX_CONFIG_FILE_BYTES) gets the same folder entry,
    so the config build reports an error that names it and config.reload keeps the current config."""
    files = {}
    for name in visible_entries(directory):
        if name in (AUTOCONFIG_NAME, EDITOR_CONFIG_NAME):
            continue
        path = os.path.join(directory, name)
        if not os.path.isdir(path):
            if name not in KNOWN_FILES:
                files[name] = ""
                continue
            text = read_text(path)
            files[name if text is not None else name + "/"] = "" if text is None else text
        elif name not in KNOWN_DIRS:
            files[name + "/"] = ""
        else:
            for entry in visible_entries(path):
                entry_path = os.path.join(path, entry)
                if os.path.isdir(entry_path):
                    files[f"{name}/{entry}/"] = ""
                    continue
                text = read_text(entry_path)
                files[f"{name}/{entry}" if text is not None else f"{name}/{entry}/"] = "" if text is None else text
    return files


def read_config():
    directory = config_dir()
    if not os.path.isdir(directory):
        return {"config_dir": directory, "config_dir_exists": False, "files": {}}
    try:
        files = read_files(directory)
    except OSError as error:
        raise HostError(f"cannot list {directory}: {error.strerror or error}") from error
    return {"config_dir": directory, "config_dir_exists": True, "files": files}


def write_autoconfig(toml_text):
    """Writes autoconfig.toml under a temporary name and renames it, so a reader never sees half a file."""
    if not isinstance(toml_text, str):
        raise HostError("write_autoconfig needs a string field toml")
    directory = config_dir()
    path = os.path.join(directory, AUTOCONFIG_NAME)
    try:
        os.makedirs(directory, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=".autoconfig-", suffix=".tmp")
    except OSError as error:
        raise HostError(f"cannot write {path}: {error.strerror or error}") from error
    try:
        with os.fdopen(descriptor, "wb") as file:
            file.write((AUTOCONFIG_HEADER + toml_text).encode("utf-8"))
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException as error:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        if isinstance(error, OSError):
            raise HostError(f"cannot write {path}: {error.strerror or error}") from error
        raise
    return {"path": path}


# The updater. The caller (the extension, over Firefox's native port) names a version and the hashes its signed build
# carries, nothing else: no URL, channel or path. Every URL comes from RELEASE_URL_TEMPLATE, every written path from
# where this host is installed.
RELEASE_URL_TEMPLATE = "https://github.com/uhs-robert/desertfox/releases/download/v{version}/{name}"
# [0-9], not \d: \d also matches digits of other scripts, which would reach the URL. The length cap keeps the tuple
# compare and the URL short. Three numbers are a stable release. A fourth number, from 1, is a beta toward the next
# release: AMO refuses letters in a version, so 0.1.23.2 is the second beta after 0.1.23.
VERSION_PATTERN = re.compile(r"([0-9]{1,6})\.([0-9]{1,6})\.([0-9]{1,6})(?:\.([1-9][0-9]{0,5}))?")
SHA256_PATTERN = re.compile(r"[0-9a-f]{64}")
UPDATE_SCRIPTS = ("desertfox-bridge", "desertfox-host", "desertfox")
UPDATE_REQUEST_FIELDS = {"cmd", "version", "sha256"}
UPDATE_MAX_FILE_BYTES = 1024 * 1024
UPDATE_TIMEOUT_S = 20
# GitHub sends a release download through one redirect to its asset storage. A few more leave room for a change there.
UPDATE_MAX_REDIRECTS = 5
SCRIPT_SHEBANG = b"#!/usr/bin/env python3\n"
STAMP_PATTERN = re.compile(rb'^RELEASE_VERSION = "([^"\n]*)"$', re.MULTILINE)
EXTENSION_ID = "desertfox@uhs-robert"
# The manifests install.sh writes, by host script. The updater writes the same content.
MANIFESTS = {
    "desertfox-host": ("desertfox_host", "DesertFox config files and saved edits"),
    "desertfox-bridge": ("desertfox_bridge", "DesertFox bridge to a desktop shell"),
}


class UpdateError(HostError):
    """A refused or failed update. Nothing was written unless the message says which files changed."""


def parse_version(text):
    """The version as a tuple that sorts in release order: x.y.z, then its betas x.y.z.1, x.y.z.2, then x.y.(z+1). None for anything else."""
    if not isinstance(text, str):
        return None
    match = VERSION_PATTERN.fullmatch(text)
    if match is None:
        return None
    major, minor, patch, beta = match.groups()
    return (int(major), int(minor), int(patch), int(beta or 0))


class HttpsOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """Follows at most UPDATE_MAX_REDIRECTS hops and refuses any hop that leaves https."""

    max_redirections = UPDATE_MAX_REDIRECTS

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.lower().startswith("https://"):
            raise UpdateError(f"refused a redirect to a URL that is not https: {newurl[:200]}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)

    def http_error_302(self, req, fp, code, msg, headers):
        # The base class reads the whole redirect body before it follows, with no size cap. Close the response unread
        # and hand the base class an empty body instead.
        fp.close()
        return super().http_error_302(req, io.BytesIO(), code, msg, headers)

    http_error_301 = http_error_303 = http_error_307 = http_error_308 = http_error_302


def https_opener(context=None):
    # Built by hand, not with build_opener: that one adds http, ftp, file and data handlers. Only https can open here.
    opener = urllib.request.OpenerDirector()
    for handler in (
        urllib.request.ProxyHandler(),
        urllib.request.HTTPSHandler(context=context or ssl.create_default_context()),
        HttpsOnlyRedirects(),
        urllib.request.HTTPErrorProcessor(),
        urllib.request.HTTPDefaultErrorHandler(),
        urllib.request.UnknownHandler(),
    ):
        opener.add_handler(handler)
    return opener


@contextlib.contextmanager
def download_deadline(url):
    """Raises UpdateError when the block runs past UPDATE_TIMEOUT_S, even inside a blocking connect or read."""
    # The socket timeout bounds each recv only, so a server that drips a byte at a time never trips it. A timer signal
    # bounds the whole download. It works because the host is one-shot and serves its request on the main thread.
    def time_out(signum, frame):
        raise UpdateError(f"timed out after {UPDATE_TIMEOUT_S} s downloading {url}")

    previous = signal.signal(signal.SIGALRM, time_out)
    signal.setitimer(signal.ITIMER_REAL, UPDATE_TIMEOUT_S)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def fetch_release_file(url, context=None):
    """The bytes at an https URL, or UpdateError. Caps the size and the total time, and refuses an http hop. `context`
    replaces the system TLS roots, for a test server."""
    if not url.startswith("https://"):
        raise UpdateError(f"refused a URL that is not https: {url}")
    try:
        with download_deadline(url), https_opener(context).open(url, timeout=UPDATE_TIMEOUT_S) as response:
            if not response.geturl().startswith("https://"):
                raise UpdateError(f"refused {url}: it ended at a URL that is not https")
            data = b""
            while len(data) <= UPDATE_MAX_FILE_BYTES:
                chunk = response.read(64 * 1024)
                if not chunk:
                    return data
                data += chunk
            raise UpdateError(f"{url} is over the {UPDATE_MAX_FILE_BYTES} byte limit")
    except UpdateError:
        raise
    except urllib.error.HTTPError as error:
        raise UpdateError(f"could not download {url}: HTTP {error.code}") from error
    # HTTPException covers a response cut off mid-body (IncompleteRead), which is not an OSError.
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as error:
        reason = getattr(error, "reason", None) or error
        raise UpdateError(f"could not download {url}: {reason}") from error


def checked_request(request):
    """The version and expected hashes of a self_update request. Refuses any other field, so no URL or path gets in."""
    extra = set(request) - UPDATE_REQUEST_FIELDS
    if extra:
        raise UpdateError(f"self_update takes only version and sha256, not {', '.join(sorted(extra))}")
    version = request.get("version")
    if parse_version(version) is None:
        raise UpdateError("self_update needs a version like 1.2.3 or 1.2.3.4")
    expected = request.get("sha256")
    if not isinstance(expected, dict) or set(expected) != set(UPDATE_SCRIPTS):
        raise UpdateError(f"self_update needs sha256 with exactly {', '.join(UPDATE_SCRIPTS)}")
    for name, digest in expected.items():
        if not isinstance(digest, str) or SHA256_PATTERN.fullmatch(digest) is None:
            raise UpdateError(f"the sha256 of {name} is not 64 lowercase hex digits")
    return version, expected


def install_paths(host_file=None):
    """The five paths install.sh writes, found from where this host runs: the two hosts and the command line beside it,
    the two manifests in ~/.mozilla/native-messaging-hosts. The link ~/.local/bin/desertfox points at the command line
    by path, so it needs no rewrite."""
    data_dir = os.path.dirname(os.path.abspath(host_file or __file__))
    manifest_dir = os.path.join(os.path.expanduser("~"), ".mozilla", "native-messaging-hosts")
    scripts = {name: os.path.join(data_dir, name) for name in UPDATE_SCRIPTS}
    manifests = {name: os.path.join(manifest_dir, f"{manifest_name}.json") for name, (manifest_name, _) in MANIFESTS.items()}
    return scripts, manifests


def take_update_lock(data_dir):
    """The open lock file in the data folder, held until it is closed. install.sh locks the same file, so it and an
    updater from any profile compute one path. A second writer gets "update running"."""
    path = os.path.join(data_dir, "update.lock")
    try:
        descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    except OSError as error:
        raise UpdateError(f"cannot open the update lock {path}: {error.strerror or error}") from error
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        os.close(descriptor)
        raise UpdateError("update running: another DesertFox host is updating now") from error
    return descriptor


def stamped_version(script_bytes):
    match = STAMP_PATTERN.search(script_bytes)
    return match.group(1).decode("utf-8", "replace") if match else None


def installed_version(host_path):
    """The release version of the host file on disk now. Another profile's update may have moved it past this process."""
    try:
        with open(host_path, "rb") as file:
            return stamped_version(file.read(UPDATE_MAX_FILE_BYTES))
    except OSError:
        return None


def file_sha256(path):
    try:
        with open(path, "rb") as file:
            return hashlib.sha256(file.read()).hexdigest()
    except OSError:
        return None


def refuse_downgrade(version, current):
    if current == "dev" or current is None:
        raise UpdateError("this host is a development install, which never updates itself. Run :native.install instead")
    current_key = parse_version(current)
    if current_key is None:
        raise UpdateError(f"the installed host has the unknown version {current!r}. Run :native.install instead")
    if parse_version(version) < current_key:
        raise UpdateError(f"refused to downgrade the host from {current} to {version}")


def checksum_line_digest(text, name):
    """The digest of a release .sha256 file, which holds one `sha256sum` line for exactly this file."""
    match = re.fullmatch(rf"([0-9a-f]{{64}})  {re.escape(name)}\n?", text)
    if match is None:
        raise UpdateError(f"the release checksum file of {name} is malformed")
    return match.group(1)


def fetch_verified(version, expected, fetch):
    """Every script of the release, in memory, each checked against the release .sha256 and the extension's hash."""
    verified = {}
    for name in UPDATE_SCRIPTS:
        url = RELEASE_URL_TEMPLATE.format(version=version, name=name)
        script = fetch(url)
        checksum_text = fetch(url + ".sha256").decode("ascii", "replace")
        actual = hashlib.sha256(script).hexdigest()
        if actual != checksum_line_digest(checksum_text, name):
            raise UpdateError(f"checksum mismatch for {name} of version {version}: the download does not match the release .sha256")
        # The release .sha256 sits beside the file, so it only catches a broken download. The extension's hash comes from
        # its signed build, so a replaced release asset fails here.
        if actual != expected[name]:
            raise UpdateError(f"checksum mismatch for {name} of version {version}: the release does not match the hash the extension carries")
        if not script.startswith(SCRIPT_SHEBANG):
            raise UpdateError(f"the downloaded {name} is not a host script")
        if name in MANIFESTS and stamped_version(script) != version:
            raise UpdateError(f"the downloaded {name} says version {stamped_version(script)!r}, not {version}")
        verified[name] = script
    return verified


def manifest_bytes(script_name, host_path):
    manifest_name, description = MANIFESTS[script_name]
    manifest = {"name": manifest_name, "description": description, "path": host_path, "type": "stdio", "allowed_extensions": [EXTENSION_ID]}
    return (json.dumps(manifest, indent=2) + "\n").encode("utf-8")


def write_new_file(path, data, mode):
    """Writes `<path>.new` with a fresh inode. A stale one from a crash is removed first."""
    staged = path + ".new"
    try:
        os.unlink(staged)
    except FileNotFoundError:
        pass
    descriptor = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        with os.fdopen(descriptor, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(staged, mode)
    except BaseException:
        # The caller cleans up only the files staged in full, so a half-written one goes here.
        try:
            os.unlink(staged)
        except OSError:
            pass
        raise
    return staged


def replace_files(writes):
    """Stages every file as `<path>.new`, then renames each over its path in order. A rename keeps the old inode alive,
    so a running bridge keeps its code. Returns the replaced paths. A failure while staging leaves every path as it was."""
    staged = []
    try:
        for path, data, mode in writes:
            staged.append((write_new_file(path, data, mode), path))
    except OSError as error:
        for staged_path, _ in staged:
            try:
                os.unlink(staged_path)
            except OSError:
                pass
        raise UpdateError(f"cannot write {error.filename}: {error.strerror or error}. Nothing was replaced") from error
    replaced = []
    for index, (staged_path, path) in enumerate(staged):
        try:
            os.replace(staged_path, path)
        except OSError as error:
            for left_path, _ in staged[index:]:
                try:
                    os.unlink(left_path)
                except OSError:
                    pass
            done = ", ".join(replaced) or "none"
            raise UpdateError(f"cannot replace {path}: {error.strerror or error}. Replaced before the failure: {done}. Run :native.install") from error
        replaced.append(path)
    # A rename lives in its folder's entry, so a power cut can undo it until the folder itself is synced.
    for folder in {os.path.dirname(path) for path in replaced}:
        sync_folder(folder)
    return replaced


def sync_folder(folder):
    try:
        descriptor = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        os.fsync(descriptor)
    except OSError:
        pass
    finally:
        os.close(descriptor)


def planned_writes(scripts, manifests, verified):
    """(path, bytes, mode) in rename order. This host goes last: its stamped version is what it reports, so until that
    rename lands the extension still sees the old version and asks again, and the next call finishes the rest."""
    writes = [(scripts[name], verified[name], 0o755) for name in ("desertfox-bridge", "desertfox")]
    writes += [(manifests[name], manifest_bytes(name, scripts[name]), 0o644) for name in ("desertfox-bridge", "desertfox-host")]
    writes.append((scripts["desertfox-host"], verified["desertfox-host"], 0o755))
    return writes


def install_is_current(scripts, manifests, expected):
    """True when every script matches its expected hash and every manifest holds the bytes the updater would write."""
    scripts_current = all(file_sha256(scripts[name]) == expected[name] for name in UPDATE_SCRIPTS)
    manifests_current = all(file_sha256(manifests[name]) == hashlib.sha256(manifest_bytes(name, scripts[name])).hexdigest() for name in MANIFESTS)
    return scripts_current and manifests_current


def self_update(request, fetch=fetch_release_file, host_file=None, current=RELEASE_VERSION):
    """Replaces the installed scripts and manifests with release `version` after every check passes.

    Checks, in order: the request shape, the version of this process, the lock, the version on disk, then each download
    against both hashes. Only then does it write, in the order of `planned_writes`. A running bridge keeps its old inode,
    and the extension reconnects to start the new one. The bridge never replaces its own file.

    The host cannot see the extension's version, so it cannot refuse a version newer than the extension by itself. The
    hashes do it: they come from the extension's own build, so any other version fails the hash check."""
    version, expected = checked_request(request)
    refuse_downgrade(version, current)
    scripts, manifests = install_paths(host_file)
    lock = take_update_lock(os.path.dirname(scripts["desertfox-host"]))
    try:
        refuse_downgrade(version, installed_version(scripts["desertfox-host"]))
        if install_is_current(scripts, manifests, expected):
            return {"updated": False, "version": version, "replaced": []}
        verified = fetch_verified(version, expected, fetch)
        replaced = replace_files(planned_writes(scripts, manifests, verified))
    finally:
        os.close(lock)
    return {"updated": True, "version": version, "replaced": replaced}


# The external editor. editor_start writes the text to a scratch file and starts the user's editor on it, detached, then
# this process exits like every other host process. editor_collect runs in a later process, so the two share only files
# in EDITOR_DIR: the scratch file and a job file that names it.
EDITOR_ARGV_KEY = "argv"
EDITOR_INSERT_KEY = "insert_argv"
FILE_PLACEHOLDER = "{file}"
EXT_PATTERN = re.compile(r"[A-Za-z0-9]{1,10}")
# The text rides inside a JSON reply that Firefox drops above 1 MiB. JSON escapes one character into at most 6 bytes.
MAX_EDITOR_TEXT_BYTES = MAX_REPLY_BYTES // 8
COLLECT_WAIT_S = 20
COLLECT_POLL_S = 0.1
STALE_JOB_S = 24 * 60 * 60
JOB_PATTERN = re.compile(r"[0-9a-f]{32}")


def editor_dir():
    cache_home = os.environ.get("XDG_CACHE_HOME", "")
    if not os.path.isabs(cache_home):
        cache_home = os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(cache_home, "desertfox", "editor")


def read_toml_strings(text):
    """The `key = ["a", 'b']` entries of an editor.toml. This is the only TOML shape the file takes, and the host parses it
    itself because python3 3.9 has no tomllib. Strings are basic ("..." with JSON escapes) or literal ('...')."""
    values = {}
    position = 0
    skip = re.compile(r"(?:\s|#[^\n]*)*")
    key_pattern = re.compile(r"([A-Za-z0-9_-]+)\s*=\s*\[")
    string_pattern = re.compile(r'"((?:[^"\\\n]|\\.)*)"|\'([^\'\n]*)\'')
    while True:
        position = skip.match(text, position).end()
        if position == len(text):
            return values
        key = key_pattern.match(text, position)
        if key is None:
            raise HostError(f"expected name = [\"...\"] near {text[position:position + 20]!r}")
        if key.group(1) in values:
            raise HostError(f"{key.group(1)} is set twice")
        items = []
        position = key.end()
        while True:
            position = skip.match(text, position).end()
            if text.startswith("]", position):
                position += 1
                break
            string = string_pattern.match(text, position)
            if string is None:
                raise HostError(f"expected a quoted string in {key.group(1)} near {text[position:position + 20]!r}")
            if string.group(1) is not None:
                try:
                    items.append(json.loads('"' + string.group(1) + '"'))
                except ValueError as error:
                    raise HostError(f"bad escape in {key.group(1)}: {string.group(0)}") from error
            else:
                items.append(string.group(2))
            position = skip.match(text, string.end()).end()
            if text.startswith(",", position):
                position += 1
            elif not text.startswith("]", position):
                raise HostError(f"expected , or ] in {key.group(1)} near {text[position:position + 20]!r}")
        values[key.group(1)] = items


def load_editor_config():
    """(argv, insert_argv) from editor.toml. Both are lists of strings. `argv` needs one element with {file}."""
    path = os.path.join(config_dir(), EDITOR_CONFIG_NAME)
    if not os.path.isfile(path):
        raise HostError(f'no editor is set up: create {path} with a line like argv = ["your-terminal", "-e", "your-editor", "{{file}}"]')
    try:
        values = read_toml_strings(read_text(path))
    except HostError as error:
        raise HostError(f"{path} is broken: {error}") from error
    extra = set(values) - {EDITOR_ARGV_KEY, EDITOR_INSERT_KEY}
    if extra:
        raise HostError(f"{path} is broken: unknown key {', '.join(sorted(extra))} (known: {EDITOR_ARGV_KEY}, {EDITOR_INSERT_KEY})")
    argv = values.get(EDITOR_ARGV_KEY)
    if not argv or not any(FILE_PLACEHOLDER in item for item in argv):
        raise HostError(f"{path} is broken: argv must be a list with the program first and {FILE_PLACEHOLDER} in one element")
    if not argv[0] or FILE_PLACEHOLDER in argv[0]:
        raise HostError(f"{path} is broken: the first element of argv must be the program, without {FILE_PLACEHOLDER}")
    return argv, values.get(EDITOR_INSERT_KEY, [])


def editor_command(argv, insert_argv, scratch_path, insert):
    """The argv to run. The insert_argv elements go just before the first element that holds {file}, so for
    `["term", "-e", "nvim", "{file}"]` they land after the editor program. No shell is involved: each element is one argument."""
    command = list(argv)
    if insert:
        slot = next(index for index, item in enumerate(command) if FILE_PLACEHOLDER in item)
        command[slot:slot] = insert_argv
    return [item.replace(FILE_PLACEHOLDER, scratch_path) for item in command]


def process_start_ticks(pid):
    """Field 22 of /proc/<pid>/stat, or None when the process is gone or a zombie. The start time tells a reused pid from the editor."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as file:
            stat = file.read().decode("utf-8", "replace")
    except OSError:
        return None
    fields = stat[stat.rindex(")") + 2:].split()
    return None if fields[0] == "Z" else fields[19]


def editor_is_running(pid, start_ticks):
    return start_ticks is not None and process_start_ticks(pid) == start_ticks


def remove_quietly(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def sweep_stale_jobs(directory):
    """Removes the files of a job whose editor is gone and which nobody collected for a day (a closed browser). A claimed
    `.done` job file, left by a collector that died after claiming, goes the same way."""
    for name in os.listdir(directory):
        if not (name.startswith("job-") and (name.endswith(".json") or name.endswith(".done"))):
            continue
        path = os.path.join(directory, name)
        try:
            if time.time() - os.stat(path).st_mtime < STALE_JOB_S:
                continue
            job = json.loads(read_text(path))
            if editor_is_running(job["pid"], job["start_ticks"]):
                continue
            remove_quietly(os.path.join(directory, os.path.basename(job["scratch"])))
        except (OSError, ValueError, KeyError, TypeError, HostError):
            pass
        remove_quietly(path)


def checked_fields(request, allowed, verb):
    extra = set(request) - allowed - {"cmd"}
    if extra:
        raise HostError(f"{verb} takes only {', '.join(sorted(allowed))}, not {', '.join(sorted(extra))}")


def editor_start(request):
    """Writes the text to a private scratch file, runs the configured editor on it and returns the job id."""
    checked_fields(request, {"text", "ext", "insert"}, "editor_start")
    text, ext, insert = request.get("text"), request.get("ext"), request.get("insert", False)
    if not isinstance(text, str):
        raise HostError("editor_start needs a string field text")
    if ext is not None and (not isinstance(ext, str) or EXT_PATTERN.fullmatch(ext) is None):
        raise HostError("the file extension must be 1 to 10 letters or digits")
    if not isinstance(insert, bool):
        raise HostError("editor_start takes a boolean insert")
    try:
        data = text.encode("utf-8")
    except UnicodeEncodeError as error:
        raise HostError("the text is not valid unicode") from error
    if len(data) > MAX_EDITOR_TEXT_BYTES:
        raise HostError(f"the text is {len(data)} bytes, over the {MAX_EDITOR_TEXT_BYTES} byte limit for the external editor")
    argv, insert_argv = load_editor_config()
    directory = editor_dir()
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        os.chmod(directory, 0o700)
        sweep_stale_jobs(directory)
    except OSError as error:
        raise HostError(f"cannot prepare {directory}: {error.strerror or error}") from error
    job = secrets.token_hex(16)
    scratch_name = f"doc-{time.strftime('%Y%m%d-%H%M%S')}-{job[:8]}" + (f".{ext}" if ext else "")
    scratch_path = os.path.join(directory, scratch_name)
    job_path = os.path.join(directory, f"job-{job}.json")
    try:
        descriptor = os.open(scratch_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(descriptor, "wb") as file:
            file.write(data)
        # An mtime a minute back, so a save always changes it, even on a filesystem with coarse time stamps.
        past = time.time() - 60
        os.utime(scratch_path, (past, past))
        saved_mtime_ns = os.stat(scratch_path).st_mtime_ns
    except OSError as error:
        remove_quietly(scratch_path)
        raise HostError(f"cannot write {scratch_path}: {error.strerror or error}") from error
    try:
        process = subprocess.Popen(
            editor_command(argv, insert_argv, scratch_path, insert),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            close_fds=True, start_new_session=True,
        )
    except (OSError, ValueError) as error:
        remove_quietly(scratch_path)
        raise HostError(f"cannot start {argv[0]!r} from {EDITOR_CONFIG_NAME}: {getattr(error, 'strerror', None) or error}") from error
    record = {"scratch": scratch_name, "mtime_ns": saved_mtime_ns, "pid": process.pid, "start_ticks": process_start_ticks(process.pid)}
    try:
        descriptor = os.open(job_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            json.dump(record, file)
    except OSError as error:
        # The editor is already running with no job to collect it, so end its whole session first.
        with contextlib.suppress(OSError):
            os.killpg(process.pid, signal.SIGKILL)
        process.wait()
        remove_quietly(job_path)
        remove_quietly(scratch_path)
        raise HostError(f"cannot write {job_path}: {error.strerror or error}") from error
    return {"job": job}


def read_job(directory, job):
    if not isinstance(job, str) or JOB_PATTERN.fullmatch(job) is None:
        raise HostError("unknown editor job")
    path = os.path.join(directory, f"job-{job}.json")
    try:
        record = json.loads(read_text(path))
        return path, record, os.path.join(directory, os.path.basename(record["scratch"]))
    except (HostError, ValueError, KeyError, TypeError) as error:
        raise HostError("unknown editor job: it never ran or its text was already taken") from error


def claim_job(job_path):
    """Claims the job by renaming its file, so of two collectors exactly one gets the text and removes the files."""
    claimed = f"{job_path}.{os.getpid()}.done"
    try:
        os.rename(job_path, claimed)
    except FileNotFoundError as error:
        raise HostError("unknown editor job: its text was already taken") from error
    return claimed


def collect_result(record, scratch_path, claimed_job):
    """The reply for a finished job. The files are removed on every path out, so no outcome leaves one behind."""
    try:
        try:
            changed = os.stat(scratch_path).st_mtime_ns != record["mtime_ns"]
        except FileNotFoundError:
            raise HostError("the scratch file of the editor job is gone") from None
        if not changed:
            return {"done": True, "changed": False}
        with open(scratch_path, "rb") as file:
            data = file.read(MAX_EDITOR_TEXT_BYTES + 1)
        if len(data) > MAX_EDITOR_TEXT_BYTES:
            raise HostError(f"the edited text is over the {MAX_EDITOR_TEXT_BYTES} byte limit, so it was dropped")
        return {"done": True, "changed": True, "text": data.decode("utf-8", errors="replace").rstrip("\r\n")}
    except OSError as error:
        raise HostError(f"cannot read {scratch_path}: {error.strerror or error}") from error
    finally:
        remove_quietly(scratch_path)
        remove_quietly(claimed_job)


def editor_collect(request, wait_s=COLLECT_WAIT_S):
    """Waits up to `wait_s` for the editor to end, then answers {"pending": true} or the result.

    The file is read only after the editor exited, so a write in progress is never read. While the editor runs, a
    missing or changing file is a save in progress (a rename-and-write save removes the name for a moment), and the
    answer stays pending. A job that exited without saving gives changed false."""
    checked_fields(request, {"job"}, "editor_collect")
    directory = editor_dir()
    job_path, record, scratch_path = read_job(directory, request.get("job"))
    deadline = time.monotonic() + wait_s
    while editor_is_running(record["pid"], record["start_ticks"]):
        if time.monotonic() >= deadline:
            return {"pending": True}
        time.sleep(COLLECT_POLL_S)
    return collect_result(record, scratch_path, claim_job(job_path))


# The request names a key, never a URL, so the host opens only these pages.
FIREFOX_PAGES = {
    "settings": "about:preferences",
    "addons": "about:addons",
    "downloads": "about:downloads",
    "config": "about:config",
    "profiles": "about:profiles",
    "support": "about:support",
    "debugging": "about:debugging#/runtime/this-firefox",
    "logins": "about:logins",
    "processes": "about:processes",
    "memory": "about:memory",
    "policies": "about:policies",
    "crashes": "about:crashes",
    "protections": "about:protections",
}
FIREFOX_BINARY_NAMES = {"firefox", "firefox-bin", "firefox-esr", "firefox-esr-bin"}
# A package upgrade under a running Firefox leaves this on the link of its exe.
DELETED_EXE_SUFFIX = " (deleted)"
PROFILE_LOCK_NAME = ".parentlock"
CRASH_EVENTS_SUFFIX = os.path.join("crashes", "events")
# The remote client hands the URL over and exits within about a second.
FIREFOX_REMOTE_TIMEOUT_S = 10
# The crash reporter and startup variables belong to the parent Firefox, not to the short-lived remote client.
# MOZ_NO_REMOTE and MOZ_NEW_INSTANCE tell a client not to hand the URL over, so it would start a second Firefox instead.
DROPPED_ENV_PREFIXES = ("MOZ_CRASHREPORTER_", "XRE_")
DROPPED_ENV_NAMES = {"MOZ_LAUNCHED_CHILD", "MOZ_APP_SILENT_START", "MOZ_NO_REMOTE", "MOZ_NEW_INSTANCE"}
STDERR_TAIL_BYTES = 4096


def firefox_binary(proc_dir):
    """The exe of the parent process, which must be a Firefox binary. A run by hand or by another program is refused."""
    try:
        exe = os.readlink(os.path.join(proc_dir, "exe"))
    except OSError as error:
        raise HostError(f"cannot read the program that started the host: {error.strerror or error}") from error
    exe = exe.removesuffix(DELETED_EXE_SUFFIX)
    if os.path.basename(exe) not in FIREFOX_BINARY_NAMES:
        raise HostError(f"the host was not started by Firefox but by {exe}, so it cannot open a Firefox page")
    if not os.access(exe, os.X_OK):
        raise HostError(f"the Firefox program {exe} is gone or cannot run, probably replaced by an update. Restart Firefox, then try again.")
    return exe


def profile_from_lock(proc_dir):
    """The folder of the `.parentlock` the parent holds open, or None. Only the main process holds it."""
    fd_dir = os.path.join(proc_dir, "fd")
    try:
        names = os.listdir(fd_dir)
    except OSError:
        return None
    for name in names:
        try:
            target = os.readlink(os.path.join(fd_dir, name))
        except OSError:
            continue
        if os.path.basename(target) == PROFILE_LOCK_NAME:
            return os.path.dirname(target)
    return None


def profile_from_env(environ):
    events = environ.get("MOZ_CRASHREPORTER_EVENTS_DIRECTORY", "")
    head, tail = os.path.split(events.rstrip("/"))
    head, middle = os.path.split(head)
    if os.path.join(middle, tail) != CRASH_EVENTS_SUFFIX:
        return None
    return head


def firefox_profile(proc_dir, environ):
    """The profile folder of the parent Firefox. Without `--profile` the remote would go to the default profile."""
    from_lock, from_env = profile_from_lock(proc_dir), profile_from_env(environ)
    if from_lock is None and from_env is None:
        raise HostError("cannot find the profile of the Firefox that started the host: it holds no .parentlock open and MOZ_CRASHREPORTER_EVENTS_DIRECTORY is unset")
    if from_lock is not None and from_env is not None and os.path.realpath(from_lock) != os.path.realpath(from_env):
        raise HostError(f"the profile of the Firefox that started the host is unclear: its lock is in {from_lock}, its crash reporter in {from_env}")
    profile = from_lock if from_lock is not None else from_env
    if not os.path.isabs(profile):
        raise HostError(f"the profile path {profile!r} is not absolute")
    if not os.path.isfile(os.path.join(profile, PROFILE_LOCK_NAME)):
        raise HostError(f"the profile {profile} holds no {PROFILE_LOCK_NAME}, so it is not the profile of a running Firefox")
    return profile


def firefox_remote_env(environ):
    return {
        name: value for name, value in environ.items()
        if not name.startswith(DROPPED_ENV_PREFIXES) and name not in DROPPED_ENV_NAMES
    }


def run_firefox_remote(argv, env):
    """Runs the remote client in a session of its own and waits at most FIREFOX_REMOTE_TIMEOUT_S.

    Stdin and stdout are the protocol pipe of the host, so the child gets /dev/null for both. Stderr goes to a temporary
    file, not a pipe: a grandchild that keeps a pipe open would block a read until it exits. When the remote finds no
    running Firefox to take the URL, it starts a whole second browser, and that one waits on a dialog forever. So a
    timeout kills the whole process group."""
    with tempfile.TemporaryFile() as stderr_file:
        try:
            process = subprocess.Popen(
                argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=stderr_file,
                env=env, close_fds=True, start_new_session=True,
            )
        except OSError as error:
            raise HostError(f"cannot start {argv[0]}: {error.strerror or error}") from error
        try:
            returncode = process.wait(timeout=FIREFOX_REMOTE_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            raise HostError(f"Firefox did not take the request within {FIREFOX_REMOTE_TIMEOUT_S} s") from None
        if returncode == 0:
            return
        stderr_file.seek(max(0, os.fstat(stderr_file.fileno()).st_size - STDERR_TAIL_BYTES))
        lines = stderr_file.read().decode("utf-8", errors="replace").strip().splitlines()
        reason = lines[-1].strip() if lines else "no message"
        raise HostError(f"Firefox refused to open the page (exit {returncode}): {reason}")


def open_firefox_page(request, parent_pid=None, proc_root="/proc", environ=None):
    """Asks the Firefox that started the host to open one page of FIREFOX_PAGES in a new tab.

    The program and the profile come from the kernel's view of the parent process, never from the request."""
    checked_fields(request, {"page"}, "open_firefox_page")
    page = request.get("page")
    if not isinstance(page, str) or page not in FIREFOX_PAGES:
        raise HostError(f"unknown Firefox page {page!r}. Known pages: {', '.join(FIREFOX_PAGES)}")
    environ = os.environ if environ is None else environ
    proc_dir = os.path.join(proc_root, str(os.getppid() if parent_pid is None else parent_pid))
    exe = firefox_binary(proc_dir)
    profile = firefox_profile(proc_dir, environ)
    run_firefox_remote([exe, "--profile", profile, FIREFOX_PAGES[page]], firefox_remote_env(environ))
    return {"page": page}


def handle(request):
    if not isinstance(request, dict):
        raise HostError("the request must be a JSON object")
    cmd = request.get("cmd")
    if cmd == "read_config":
        return read_config()
    if cmd == "write_autoconfig":
        return write_autoconfig(request.get("toml"))
    if cmd == "self_update":
        return self_update(request)
    if cmd == "editor_start":
        return editor_start(request)
    if cmd == "editor_collect":
        return editor_collect(request)
    if cmd == "open_firefox_page":
        return open_firefox_page(request)
    raise HostError(f"unknown cmd: {cmd!r}")


class Channel:
    """The extension's end of the pipe. The lock keeps a reply in one piece if a second writer is ever added."""

    def __init__(self, stdin, stdout):
        self.stdin = stdin
        self.stdout = stdout
        self.write_lock = threading.Lock()

    def read_message(self):
        header = self.stdin.read(4)
        if len(header) < 4:
            return None
        length = struct.unpack("=I", header)[0]
        if length > MAX_REQUEST_BYTES:
            raise HostError(f"the request is {length} bytes, over the {MAX_REQUEST_BYTES} byte limit")
        data = self.stdin.read(length)
        if len(data) < length:
            raise HostError("the request ended before its announced length")
        try:
            return json.loads(data)
        except ValueError as error:
            raise HostError(f"the request is not valid JSON: {error}") from error

    def send(self, message):
        data = json.dumps(message, ensure_ascii=False).encode("utf-8")
        if len(data) > MAX_REPLY_BYTES:
            data = json.dumps(
                {"ok": False, "host_version": HOST_VERSION, "release_version": RELEASE_VERSION, "error": f"the reply is {len(data)} bytes, over Firefox's {MAX_REPLY_BYTES} byte limit for a host reply. Shrink the snippets or CSS in {config_dir()}."}
            ).encode("utf-8")
        with self.write_lock:
            self.stdout.write(struct.pack("=I", len(data)) + data)
            self.stdout.flush()


def serve(channel):
    """Answers one request. Returns 0 when it replied, 1 when stdin closed with no request."""
    try:
        request = channel.read_message()
        if request is None:
            return 1
        reply = {"ok": True, "host_version": HOST_VERSION, "release_version": RELEASE_VERSION, **handle(request)}
    except HostError as error:
        reply = {"ok": False, "host_version": HOST_VERSION, "release_version": RELEASE_VERSION, "error": str(error)}
    channel.send(reply)
    return 0


def main():
    return serve(Channel(sys.stdin.buffer, sys.stdout.buffer))


if __name__ == "__main__":
    sys.exit(main())
