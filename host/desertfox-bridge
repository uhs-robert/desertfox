#!/usr/bin/env python3
"""Bridge host for the DesertFox Firefox extension.

Firefox starts it over `connectNative` and keeps it alive while the extension holds the port. Frames are a 4-byte
native-endian length and UTF-8 JSON, both ways. The host takes the lock first, then says {"ready": true,
"host_version": 1} once. It takes three verbs from the extension and no others:

  {"verb": "mode", "id", "label", "private", "tab_id", "window_id"}
  {"verb": "reply", "request_id", "ok", "message"?, "commands"?}    the answer to a request the host sent
  {"verb": "event", "event", ...fields}                             a tab event for subscribers (see EVENT_FIELDS)

A private window sends no ids. The host drops them anyway, so a private window leaves only its mode and private:true.

The host keeps the latest mode and writes one snapshot, $XDG_RUNTIME_DIR/desertfox/state.json, for a desktop shell to
read (the shape is in host/README.md). Every write goes to a temp file in the same folder and is renamed over the state
file, so a reader never sees a partial file.

It also owns a Unix socket, $XDG_RUNTIME_DIR/desertfox/bridge.sock, mode 0600. Whoever holds the flock on bridge.lock
owns the socket and the state file: the first host wins, and a second one waits LOCK_WAIT_S for the lock, then exits
without saying ready. The socket speaks one JSON object per line, one reply line per request. It answers `ping`,
`state`, `run`, `list` and the tab verbs `tabs`, `activate`, `clear_preface`, `close` and `capture`. Each goes to the
extension as {"verb", "request_id", ...fields}, and the extension decides what runs: it holds the bridge field, the
never-list, the argument validator, the bridge_share_tabs opt-in and the private-window filter. The host only
forwards, limits the rate and routes each reply back to the connection that asked. A run reply is cut to `ok` and a
short `message`, and a tab reply to its known fields, so no page data can pass through the host unchecked. The host
keeps two caches of its own, the tab thumbnails and the tab icons (see `cache_dir`), and writes a file only for a tab
the extension just listed. Stdout carries only protocol bytes. The host never runs anything it is sent.

`subscribe` turns a connection into a one-way stream: one {"ok": true} line, then one line per event, each with a
`seq`. The host makes a `mode` event of each mode it takes, and passes on the extension's tab events. A subscriber
that falls behind or stops reading is dropped (see EventHub).
"""
import base64
import fcntl
import hashlib
import json
import os
import re
import select
import shutil
import signal
import socket
import struct
import sys
import tempfile
import threading
import time
import urllib.parse
from collections import deque

HOST_VERSION = 1
STATE_VERSION = 2
# A message above this size is skipped, not parsed.
MAX_MESSAGE_BYTES = 1024 * 1024
# A frame that claims more than this cannot be skipped in reasonable time, so the host ends instead.
MAX_SKIPPED_BYTES = 256 * 1024 * 1024
MAX_TEXT_CHARS = 64
LOCK_WAIT_S = 3
MAX_REQUEST_BYTES = 64 * 1024
IDLE_TIMEOUT_S = 5
MAX_CONNECTIONS = 16
ACCEPT_RETRY_S = 0.1
# For the whole host, at most this many run and list requests in any window. The CLI opens a connection per call, so a limit per connection would never stop a loop.
RATE_LIMIT_REQUESTS = 10
RATE_WINDOW_S = 1.0
# Requests waiting on the extension, over all connections.
MAX_PENDING = 16
REQUEST_TIMEOUT_S = 10
# How long shutdown waits for waiting clients to receive their failure.
DRAIN_S = 1.0
MAX_COMMAND_CHARS = 4096
MAX_REPLY_MESSAGE_CHARS = 500
PREFACE_PATTERN = re.compile(r"[A-Za-z0-9]{1,32}")
# Rendering one tab, a background one included, takes longer than answering from the tab list.
CAPTURE_TIMEOUT_S = 5
MAX_CAPTURE_IDS = 64
# Only files of no open tab are pruned, and only once this old, so a tab closed by mistake and reopened keeps its image and icon.
CACHE_KEEP_S = 7 * 24 * 3600
# At most this many images stay in each cache, the oldest going first, so a long run of changing addresses cannot fill the disk.
MAX_CACHE_FILES = 500
JPEG_DATA_URL_PREFIX = "data:image/jpeg;base64,"
# The fields of a listed tab the host passes on, with the type each must have. Anything else, a private flag included, is dropped.
TAB_FIELDS = {
    "tab_id": int, "window_id": int, "title": str, "url": str, "active": bool, "audible": bool, "discarded": bool,
    "last_accessed": int, "pinned": bool, "hidden": bool, "fav_icon_url": str, "fav_icon_key": str,
}
# The extension names a stored icon by the SHA-256 of its data URL. The file keeps the suffix of its image type, so an image viewer needs no sniffing.
FAVICON_KEY_PATTERN = re.compile(r"[0-9a-f]{64}")
FAVICON_SUFFIXES = {
    "image/png": ".png", "image/svg+xml": ".svg", "image/x-icon": ".ico", "image/vnd.microsoft.icon": ".ico",
    "image/jpeg": ".jpg", "image/gif": ".gif", "image/webp": ".webp",
}
MAX_FAVICON_BYTES = 256 * 1024
# Filling missing icons makes a `tabs` call slower once, so the whole fill has one short budget and the next call fills the rest.
FAVICON_FILL_BUDGET_S = 3
# Subscribers to the event stream, inside MAX_CONNECTIONS, so a few stuck ones cannot starve the command line.
MAX_SUBSCRIBERS = 4
# Events waiting for one subscriber. A subscriber that falls this far behind is dropped and can reconnect.
SUBSCRIBER_QUEUE_EVENTS = 64
WRITE_TIMEOUT_S = 2
# The tab ids each subscriber remembers for `tab_removed`. The one named longest ago is forgotten first.
MAX_NAMED_TABS = 1024
# How often an idle subscriber's socket is checked for a client that left.
PEER_CHECK_S = 0.5
# The fields of each event type the extension may send, with their types. A tab event needs bridge_share_tabs, which the extension checks.
EVENT_FIELDS = {
    "tab_activated": {"tab_id": int, "window_id": int},
    "tab_updated": {"tab_id": int, "window_id": int, "title": str, "url": str},
    "tab_audible": {"tab_id": int, "window_id": int, "audible": bool, "title": str, "url": str},
    "tab_removed": {"tab_id": int},
    "tabs_off": {},
}
EVENT_TEXT_CHARS = {"title": 512, "url": 2048}


class StopHost(Exception):
    """Raised to end the main loop cleanly: EOF, SIGTERM or a frame the host cannot skip."""


def log(text):
    sys.stderr.write("desertfox-bridge: %s\n" % text)
    sys.stderr.flush()


def runtime_paths():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(runtime_dir):
        raise OSError("XDG_RUNTIME_DIR is not set to an absolute path")
    folder = os.path.join(runtime_dir, "desertfox")
    return {name: os.path.join(folder, name) for name in ("state.json", "bridge.sock", "bridge.lock")} | {"folder": folder}


def process_start(pid):
    """Field 22 of /proc/<pid>/stat as a string, the same probe the shell reader uses. The name field may hold spaces and
    parentheses, so the fields count from the last closing parenthesis."""
    with open("/proc/%d/stat" % pid, "rb") as stat_file:
        text = stat_file.read().decode("utf-8", "replace")
    return text[text.rindex(")") + 2 :].split()[19]


def is_text(value, limit=MAX_TEXT_CHARS):
    return isinstance(value, str) and len(value) <= limit


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def checked_mode(message):
    """(firefox, mode) for the snapshot, or None for a message that is not a well-formed mode."""
    if not (is_text(message.get("id")) and is_text(message.get("label")) and isinstance(message.get("private"), bool)):
        return None
    mode = {"id": message["id"], "label": message["label"]}
    if message["private"]:
        return {"private": True}, mode
    if not all(is_int(message.get(name)) for name in ("tab_id", "window_id")):
        return None
    mode["tab_id"] = message["tab_id"]
    return {"window_id": message["window_id"], "private": False}, mode


class BridgeState:
    """The latest mode, shared between the port thread that writes it and the socket threads that read it."""

    def __init__(self, state_path, pid, start):
        self.state_path = state_path
        self.pid = pid
        self.start = start
        self.seq = 0
        self.firefox = None
        self.mode = None
        self.guard = threading.Lock()

    def apply(self, checked):
        """Takes one checked mode and writes the file."""
        with self.guard:
            self.firefox, self.mode = checked
            self.seq += 1
            # Nothing is written before the first mode, because a reader needs `firefox` and `mode` to be objects.
            write_atomically(self.state_path, self.snapshot_locked())

    def snapshot_locked(self):
        return {"version": STATE_VERSION, "seq": self.seq, "host": {"pid": self.pid, "start": self.start}, "firefox": self.firefox, "mode": self.mode}

    def snapshot(self):
        with self.guard:
            return None if self.mode is None else self.snapshot_locked()


def mode_event(firefox, mode):
    """The stream's copy of a mode: what the snapshot holds, so a private window again gives only its mode and private:true."""
    event = {"event": "mode", **mode, "private": firefox["private"]}
    if "window_id" in firefox:
        event["window_id"] = firefox["window_id"]
    return event


def checked_event(message):
    """A tab event from the extension cut to the fields of its type, or None. An event of an unknown type, with a wrong
    field or flagged private is dropped, a second line behind the extension's own filter."""
    kind = message.get("event")
    fields = EVENT_FIELDS.get(kind) if isinstance(kind, str) else None
    if fields is None or message.get("private") is True or message.get("incognito") is True:
        return None
    if not all(type(message.get(name)) is field_type for name, field_type in fields.items()):
        return None
    event = {"event": kind}
    for name in fields:
        value = message[name]
        event[name] = value[: EVENT_TEXT_CHARS[name]] if name in EVENT_TEXT_CHARS else value
    return event


class Subscriber:
    """One connection that streams events. Its queue is filled by the port thread and emptied by the connection's own
    thread, so a slow reader never holds up the port, the requests or the other subscribers."""

    def __init__(self, connection):
        self.connection = connection
        self.queue = deque()
        self.wake = threading.Condition()
        self.ended = False
        # The tab ids this subscriber was told about, oldest first. A `tab_removed` reaches it only for one of these.
        self.named_tabs = {}

    def offer(self, line):
        """False when the subscriber has ended or its queue is full. A line it has no use for counts as taken."""
        with self.wake:
            if self.ended:
                return False
            if not self.wants(line):
                return True
            if len(self.queue) >= SUBSCRIBER_QUEUE_EVENTS:
                return False
            self.queue.append(line)
            self.wake.notify()
            return True

    def wants(self, line):
        """Keeps `named_tabs` up to date and says whether the line goes to this subscriber."""
        event = line.get("event")
        tab_id = line.get("tab_id")
        if event == "tabs_off":
            self.named_tabs.clear()
        elif event == "tab_removed":
            return self.named_tabs.pop(tab_id, None) is not None
        elif tab_id is not None:
            self.named_tabs.pop(tab_id, None)
            self.named_tabs[tab_id] = True
            if len(self.named_tabs) > MAX_NAMED_TABS:
                del self.named_tabs[next(iter(self.named_tabs))]
        return True

    def end(self):
        """Callable from any thread. Shutdown, not close, wakes a write blocked on a full socket without freeing a descriptor the connection thread still uses."""
        with self.wake:
            self.ended = True
            self.wake.notify()
        try:
            self.connection.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def next_batch(self):
        """The queued lines, an empty list when PEER_CHECK_S passed with none, or None once the subscriber has ended."""
        with self.wake:
            if not self.queue and not self.ended:
                self.wake.wait(PEER_CHECK_S)
            if self.ended:
                return None
            batch = list(self.queue)
            self.queue.clear()
            return batch


def peer_left(connection):
    """True when the client closed its end. The stream is one-way, so anything the client sends now is read and dropped."""
    readable, _, _ = select.select([connection], [], [], 0)
    return bool(readable) and connection.recv(4096) == b""


class EventHub:
    """Hands each event to every subscriber. Every event gets the next `seq`, so a client can tell it missed one."""

    def __init__(self):
        self.guard = threading.Lock()
        self.subscribers = set()
        self.seq = 0
        self.last_mode = None
        self.closed = False

    def publish(self, event):
        with self.guard:
            self.seq += 1
            line = dict(event, seq=self.seq)
            if line["event"] == "mode":
                self.last_mode = line
            for subscriber in list(self.subscribers):
                if not subscriber.offer(line):
                    self.subscribers.discard(subscriber)
                    subscriber.end()

    def add(self, connection):
        """A new subscriber whose queue starts with the acknowledgement and the current mode, or None when the hub is full or closed.
        Both are queued under the guard, so no event can reach the client ahead of them."""
        with self.guard:
            if self.closed or len(self.subscribers) >= MAX_SUBSCRIBERS:
                return None
            subscriber = Subscriber(connection)
            subscriber.offer({"ok": True})
            if self.last_mode is not None:
                subscriber.offer(self.last_mode)
            self.subscribers.add(subscriber)
            return subscriber

    def remove(self, subscriber):
        with self.guard:
            self.subscribers.discard(subscriber)
        subscriber.end()

    def close(self):
        # Under the guard: a writer that finishes now waits in `remove` and has not closed its socket, so `end` never shuts down a reused descriptor.
        with self.guard:
            self.closed = True
            for subscriber in self.subscribers:
                subscriber.end()
            self.subscribers.clear()

    def stream(self, subscriber):
        """Runs on the subscriber's connection thread until the client leaves, falls behind, stops reading or the host ends."""
        connection = subscriber.connection
        connection.settimeout(WRITE_TIMEOUT_S)
        try:
            while True:
                batch = subscriber.next_batch()
                if batch is None:
                    return
                if batch:
                    connection.sendall(b"".join(json_line(line) for line in batch))
                elif peer_left(connection):
                    return
        except OSError:
            # A socket full for WRITE_TIMEOUT_S raises socket.timeout, an OSError, as does a client gone mid-write.
            pass
        finally:
            self.remove(subscriber)


def write_atomically(path, state):
    directory = os.path.dirname(path)
    descriptor, temp_path = tempfile.mkstemp(prefix=".state.", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temp_file:
            json.dump(state, temp_file, separators=(",", ":"))
        os.replace(temp_path, path)
    except BaseException:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def take_lock(path, wait_s):
    """The open lock file descriptor, or None when another host held the lock for the whole wait. The kernel drops the
    lock when its holder dies, so a crashed host never leaves a lock behind."""
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    deadline = time.monotonic() + wait_s
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return descriptor
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(descriptor)
                return None
            time.sleep(0.05)


def bind_socket(path):
    """Only the lock holder calls this, so a socket file already there is a leftover of a dead host."""
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    # The mode is set at creation, so the socket is never open to other users, not even briefly.
    old_umask = os.umask(0o177)
    try:
        listener.bind(path)
    finally:
        os.umask(old_umask)
    listener.listen(MAX_CONNECTIONS)
    return listener


def peer_is_me(connection):
    pid, uid, gid = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    return uid == os.getuid()


class RateLimiter:
    """At most `limit` admitted requests in any `window_s`. A refused request is not counted, so a client that waits is served again."""

    def __init__(self, limit, window_s, clock=time.monotonic):
        self.limit = limit
        self.window_s = window_s
        self.clock = clock
        self.admitted = deque()
        self.guard = threading.Lock()

    def admit(self):
        with self.guard:
            now = self.clock()
            while self.admitted and now - self.admitted[0] >= self.window_s:
                self.admitted.popleft()
            if len(self.admitted) >= self.limit:
                return False
            self.admitted.append(now)
            return True


class Waiting:
    def __init__(self):
        self.done = threading.Event()
        self.reply = None


class Working:
    def __init__(self, link):
        self.link = link

    def __enter__(self):
        with self.link.pending_guard:
            self.link.busy += 1

    def __exit__(self, *_exc):
        with self.link.pending_guard:
            self.link.busy -= 1
            self.link.pending_guard.notify_all()


class ExtensionLink:
    """The host's way to ask the extension something. Each request gets an id, and the reply that carries the id wakes the
    one connection thread that is waiting for it, so two clients never see each other's answers."""

    def __init__(self, stdout):
        self.stdout = stdout
        self.write_guard = threading.Lock()
        self.pending_guard = threading.Condition()
        self.pending = {}
        # Requests being answered, from the start of the answer to the end of the write to the client. Shutdown waits for these, not for `pending`, which empties before the write.
        self.busy = 0
        self.next_id = 1
        # False until the ready frame is out, so a request can never reach the extension before it.
        self.open = False

    def say_ready(self):
        with self.write_guard:
            send_message(self.stdout, {"ready": True, "host_version": HOST_VERSION})
            self.open = True

    def ask(self, verb, fields, timeout_s):
        """The extension's reply dict, or {"ok": False, "message": ...} when it cannot answer."""
        waiting = Waiting()
        with self.pending_guard:
            if not self.open:
                return {"ok": False, "message": "the extension is not connected"}
            if len(self.pending) >= MAX_PENDING:
                return {"ok": False, "message": "too many requests are waiting"}
            request_id = self.next_id
            self.next_id += 1
            self.pending[request_id] = waiting
        try:
            try:
                with self.write_guard:
                    send_message(self.stdout, dict(fields, verb=verb, request_id=request_id))
            except (OSError, ValueError):
                return {"ok": False, "message": "the extension is not connected"}
            if not waiting.done.wait(timeout_s):
                return {"ok": False, "message": "the extension did not answer in time"}
            forget_caches_if_sharing_off(waiting.reply)
            return waiting.reply
        finally:
            with self.pending_guard:
                self.pending.pop(request_id, None)
                self.pending_guard.notify_all()

    def answered(self, message):
        """Takes one reply from the extension. An id nobody waits for (a late reply after a timeout) is dropped."""
        request_id = message.get("request_id")
        with self.pending_guard:
            waiting = self.pending.get(request_id) if is_int(request_id) else None
        if waiting is not None and waiting.reply is None:
            waiting.reply = message
            waiting.done.set()

    def working(self):
        return Working(self)

    def close(self):
        """The port is gone: every waiting client gets a failure now, and shutdown waits a moment for them to be told."""
        with self.pending_guard:
            self.open = False
            for waiting in self.pending.values():
                if waiting.reply is None:
                    waiting.reply = {"ok": False, "message": "the extension disconnected"}
                    waiting.done.set()
            deadline = time.monotonic() + DRAIN_S
            while self.busy and time.monotonic() < deadline:
                self.pending_guard.wait(deadline - time.monotonic())


RATE_LIMITED = {"ok": False, "message": "rate limit: too many requests, slow down"}


def run_result(reply):
    """Only success and a short message leave the host: whatever else the extension put in a run reply stops here."""
    message = reply.get("message")
    result = {"ok": reply.get("ok") is True}
    if isinstance(message, str):
        result["message"] = message[:MAX_REPLY_MESSAGE_CHARS]
    return result


def list_result(reply):
    commands = reply.get("commands")
    if reply.get("ok") is True and isinstance(commands, list):
        return {"ok": True, "commands": commands}
    return run_result(reply)


def cache_dir(name):
    # A relative XDG_CACHE_HOME is invalid by the XDG spec and ignored.
    cache_home = os.environ.get("XDG_CACHE_HOME", "")
    if not os.path.isabs(cache_home):
        cache_home = os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(cache_home, "desertfox", name)


def thumbnail_dir():
    return cache_dir("bridge-thumbs")


def favicon_dir():
    return cache_dir("bridge-favicons")


def thumbnail_path(url):
    return os.path.join(thumbnail_dir(), hashlib.sha256(url.encode("utf-8")).hexdigest() + ".jpg")


def thumbnail_fields(url):
    path = thumbnail_path(url)
    try:
        return {"thumbnail": path, "thumbnail_at": os.stat(path).st_mtime_ns // 1_000_000}
    except OSError:
        return {"thumbnail": "", "thumbnail_at": 0}


class CacheGate:
    """Orders the cache writes against the deletes. A connection thread can wait on the extension for an image while the
    port thread deletes the caches because sharing went off. Each delete bumps `generation` under the same lock as the
    writes, and a write that started under an older generation is dropped, so a deleted cache cannot come back."""

    def __init__(self):
        self.guard = threading.Lock()
        self.generation = 0

    def forget(self):
        with self.guard:
            self.generation += 1
            shutil.rmtree(thumbnail_dir(), ignore_errors=True)
            shutil.rmtree(favicon_dir(), ignore_errors=True)

    def write(self, path, data, generation):
        """False, and nothing written, when the caches were deleted since `generation` was read."""
        with self.guard:
            if generation != self.generation:
                return False
            write_cache_file(path, data)
            return True


TAB_CACHES = CacheGate()


def write_cache_file(path, data):
    """Writes under a temporary name and renames, so a reader never sees half of a file."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor, temp_path = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "wb") as temp_file:
            temp_file.write(data)
        os.replace(temp_path, path)
    except BaseException:
        os.unlink(temp_path)
        raise


def write_thumbnail(url, data_url, generation):
    if not isinstance(data_url, str) or not data_url.startswith(JPEG_DATA_URL_PREFIX):
        raise ValueError("the extension sent no JPEG")
    image = base64.b64decode(data_url[len(JPEG_DATA_URL_PREFIX):], validate=True)
    if not image.startswith(b"\xff\xd8"):
        raise ValueError("the extension sent no JPEG")
    if not TAB_CACHES.write(thumbnail_path(url), image, generation):
        raise ValueError("tab sharing went off")
    return thumbnail_fields(url)


def prune_cache(folder, keep_stems):
    """Deletes the files of no open tab once they are CACHE_KEEP_S old, then the oldest over MAX_CACHE_FILES."""
    cutoff = time.time() - CACHE_KEEP_S
    try:
        names = os.listdir(folder)
    except OSError:
        return
    left = []
    for name in names:
        path = os.path.join(folder, name)
        try:
            modified = os.stat(path).st_mtime
            if name.split(".")[0] not in keep_stems and modified < cutoff:
                os.unlink(path)
            else:
                left.append((modified, path))
        except OSError:
            pass
    for _, path in sorted(left)[: max(0, len(left) - MAX_CACHE_FILES)]:
        try:
            os.unlink(path)
        except OSError:
            pass


def prune_thumbnails(open_urls):
    prune_cache(thumbnail_dir(), {hashlib.sha256(url.encode("utf-8")).hexdigest() for url in open_urls})


def favicon_files():
    """Stored icon paths by key, from one listing of the folder."""
    try:
        names = os.listdir(favicon_dir())
    except OSError:
        return {}
    return {name.split(".")[0]: os.path.join(favicon_dir(), name) for name in names if not name.startswith(".")}


def favicon_image(data_url):
    """(suffix, bytes) of an icon data URL, base64 or percent-encoded. Raises ValueError for any other text."""
    if not isinstance(data_url, str) or not data_url.startswith("data:"):
        raise ValueError("not a data URL")
    header, comma, payload = data_url[len("data:"):].partition(",")
    media_type, *parameters = header.split(";")
    suffix = FAVICON_SUFFIXES.get(media_type.lower())
    if not comma or suffix is None:
        raise ValueError("not an icon")
    image = base64.b64decode(payload, validate=True) if "base64" in parameters else urllib.parse.unquote_to_bytes(payload)
    if not image or len(image) > MAX_FAVICON_BYTES:
        raise ValueError("the icon is empty or too large")
    return suffix, image


def fill_favicons(link, tabs, stored_icons):
    """Asks the extension for each listed icon the cache lacks, one per key, and stores it under the key of the data it
    sent. An icon that changed since the list keeps no path until the next call lists its new key."""
    deadline = time.monotonic() + FAVICON_FILL_BUDGET_S
    asked = set()
    for tab in tabs:
        key = tab.get("fav_icon_key")
        if key in stored_icons or key in asked or not FAVICON_KEY_PATTERN.fullmatch(key or ""):
            continue
        asked.add(key)
        remaining_s = deadline - time.monotonic()
        if remaining_s <= 0:
            return
        generation = TAB_CACHES.generation
        reply = link.ask("favicon", {"tab_id": tab["tab_id"]}, remaining_s)
        if reply.get("ok") is not True:
            continue
        data_url = reply.get("data_url")
        try:
            suffix, image = favicon_image(data_url)
            written_key = hashlib.sha256(data_url.encode("utf-8")).hexdigest()
            path = os.path.join(favicon_dir(), written_key + suffix)
            if TAB_CACHES.write(path, image, generation):
                stored_icons[written_key] = path
        except (ValueError, OSError):
            pass


def forget_tab_caches():
    """The images are page content the owner no longer shares, so they go at once."""
    TAB_CACHES.forget()


def forget_caches_if_sharing_off(reply):
    """The extension says `sharing: off` in a reply when `bridge_share_tabs` is off."""
    if reply.get("sharing") == "off":
        forget_tab_caches()


def listed_tabs(reply):
    """The tabs of an extension `tabs` reply, cut to the known fields with the right types. A tab the extension flagged
    private is dropped as a second line behind the extension's own filter, which never sends one."""
    tabs = []
    for entry in reply.get("tabs") if isinstance(reply.get("tabs"), list) else []:
        if not isinstance(entry, dict) or entry.get("incognito") is True or entry.get("private") is True:
            continue
        tab = {name: entry[name] for name, kind in TAB_FIELDS.items() if type(entry.get(name)) is kind}
        if "tab_id" in tab and "window_id" in tab:
            tabs.append(tab)
    return tabs


def tabs_result(reply, link, every_tab):
    """The tab list with each tab's cached thumbnail and icon. The key that names an icon stays in the host. Only a list
    of every tab prunes the icons, because a shorter one would count the icons of the other tabs as unused."""
    if reply.get("ok") is not True:
        return run_result(reply)
    tabs = listed_tabs(reply)
    stored_icons = favicon_files()
    fill_favicons(link, tabs, stored_icons)
    listed_keys = {tab["fav_icon_key"] for tab in tabs if "fav_icon_key" in tab}
    for tab in tabs:
        tab.update(thumbnail_fields(tab.get("url", "")) if "url" in tab else {"thumbnail": "", "thumbnail_at": 0})
        tab["fav_icon_path"] = stored_icons.get(tab.pop("fav_icon_key", None), "")
    if every_tab:
        prune_cache(favicon_dir(), listed_keys)
    return {"ok": True, "tabs": tabs}


def flags_result(reply, names):
    """A run-style result plus the named bool and int fields of the reply, so an activate or clear reply carries no more than it should."""
    result = run_result(reply)
    for name in names:
        value = reply.get(name)
        if isinstance(value, (bool, int)):
            result[name] = value
    return result


def capture_failure(tab_id, error):
    return {"tab_id": tab_id, "ok": False, "thumbnail": "", "thumbnail_at": 0, "error": error}


def capture_one(link, tab_id):
    generation = TAB_CACHES.generation
    reply = link.ask("capture", {"tab_id": tab_id}, CAPTURE_TIMEOUT_S)
    if reply.get("ok") is not True:
        return capture_failure(tab_id, run_result(reply).get("message", "the capture failed"))
    url = reply.get("url")
    if not isinstance(url, str) or not url:
        return capture_failure(tab_id, "the extension sent no address")
    try:
        return {"tab_id": tab_id, "ok": True, **write_thumbnail(url, reply.get("data_url"), generation)}
    except (ValueError, OSError):
        return {**capture_failure(tab_id, "the image could not be saved"), **thumbnail_fields(url)}


def capture(link, request):
    """Captures the asked tabs, or every loaded one, one at a time. Only an id from the extension's own fresh tab list is
    asked for, so the cache never holds an image of a tab the extension did not list as a normal one."""
    tab_ids = request.get("tab_ids")
    listed = link.ask("tabs", {}, REQUEST_TIMEOUT_S)
    if listed.get("ok") is not True:
        return run_result(listed)
    tabs = listed_tabs(listed)
    known = {tab["tab_id"] for tab in tabs}
    if tab_ids is None:
        tab_ids = [tab["tab_id"] for tab in tabs if not tab.get("discarded")][:MAX_CAPTURE_IDS]
    results = [capture_one(link, tab_id) if tab_id in known else capture_failure(tab_id, "no such tab") for tab_id in tab_ids]
    prune_thumbnails(tab["url"] for tab in tabs if "url" in tab)
    return {"ok": True, "results": results}


def tab_request_problem(verb, request):
    """The refusal for a tab request whose fields are wrong, or None. It is checked before the rate limit, as a run's text is, so a malformed request never reaches the extension."""
    tab_ids = request.get("tab_ids")
    preface = request.get("preface")
    if verb in ("activate", "close") and not is_int(request.get("tab_id")):
        return "%s needs a whole tab_id" % verb
    if verb == "clear_preface" and not is_int(request.get("window_id")):
        return "clear_preface needs a whole window_id"
    if verb in ("activate", "clear_preface") and preface is not None and not (isinstance(preface, str) and PREFACE_PATTERN.fullmatch(preface)):
        return "preface is letters and digits only"
    if verb == "tabs" and "current" in request and not isinstance(request["current"], bool):
        return "current is true or false"
    if verb == "capture" and tab_ids is not None and not (isinstance(tab_ids, list) and len(tab_ids) <= MAX_CAPTURE_IDS and all(is_int(tab_id) for tab_id in tab_ids)):
        return "tab_ids is a list of at most %d whole tab ids" % MAX_CAPTURE_IDS
    return None


def answer_tab_verb(verb, request, link):
    preface = request.get("preface")
    fields = {} if preface is None else {"preface": preface}
    if verb == "tabs":
        current = request.get("current") is True
        return tabs_result(link.ask("tabs", {"current": True} if current else {}, REQUEST_TIMEOUT_S), link, not current)
    if verb == "capture":
        return capture(link, request)
    if verb == "activate":
        return flags_result(link.ask("activate", dict(fields, tab_id=request["tab_id"]), REQUEST_TIMEOUT_S), ("window_id", "focused", "preface_set"))
    if verb == "close":
        return run_result(link.ask("close", {"tab_id": request["tab_id"]}, REQUEST_TIMEOUT_S))
    return flags_result(link.ask("clear_preface", dict(fields, window_id=request["window_id"]), REQUEST_TIMEOUT_S), ("cleared",))


TAB_VERBS = ("tabs", "activate", "clear_preface", "close", "capture")


def answer(request, state, link, limiter):
    verb = request.get("verb") if isinstance(request, dict) else None
    if verb == "ping":
        return {"ok": True}
    if verb == "state":
        return {"ok": True, "state": state.snapshot()}
    if verb == "run":
        command = request.get("command")
        if not isinstance(command, str) or not command.strip() or len(command) > MAX_COMMAND_CHARS:
            return {"ok": False, "message": "run needs a command text"}
        tab_id = request.get("tab_id")
        if "tab_id" in request and not is_int(tab_id):
            return {"ok": False, "message": "tab_id is a whole number"}
        if not limiter.admit():
            return RATE_LIMITED
        fields = {"command": command, "tab_id": tab_id} if "tab_id" in request else {"command": command}
        return run_result(link.ask("run", fields, REQUEST_TIMEOUT_S))
    if verb == "list":
        if not limiter.admit():
            return RATE_LIMITED
        return list_result(link.ask("list", {}, REQUEST_TIMEOUT_S))
    if verb in TAB_VERBS:
        problem = tab_request_problem(verb, request)
        if problem:
            return {"ok": False, "message": problem}
        if not limiter.admit():
            return RATE_LIMITED
        return answer_tab_verb(verb, request, link)
    return {"ok": False, "message": "unknown verb"}


def subscribe(connection, hub, limiter):
    """Turns the connection into a one-way event stream until it ends. A subscription counts once against the rate
    limit, and the events it gets do not count. It waits on no extension reply, so it stays out of `link.working()`,
    which host shutdown waits for, and out of the idle timeout."""
    if not limiter.admit():
        reply(connection, RATE_LIMITED)
        return
    subscriber = hub.add(connection)
    if subscriber is None:
        reply(connection, {"ok": False, "message": "too many subscribers"})
        return
    hub.stream(subscriber)


def serve_connection(connection, state, link, hub, limiter, release_slot):
    try:
        if not peer_is_me(connection):
            return
        connection.settimeout(IDLE_TIMEOUT_S)
        pending = b""
        while True:
            while b"\n" not in pending:
                if len(pending) > MAX_REQUEST_BYTES:
                    reply(connection, {"ok": False, "message": "request too large"})
                    return
                chunk = connection.recv(4096)
                if not chunk:
                    return
                pending += chunk
            line, _, pending = pending.partition(b"\n")
            try:
                request = json.loads(line.decode("utf-8"))
            except (ValueError, RecursionError):
                reply(connection, {"ok": False, "message": "not JSON"})
                continue
            if isinstance(request, dict) and request.get("verb") == "subscribe":
                subscribe(connection, hub, limiter)
                return
            with link.working():
                reply(connection, answer(request, state, link, limiter))
    except OSError:
        pass
    finally:
        connection.close()
        release_slot()


def json_line(message):
    return json.dumps(message, separators=(",", ":")).encode("utf-8") + b"\n"


def reply(connection, message):
    connection.sendall(json_line(message))


def accept_loop(listener, state, link, hub):
    slots = threading.BoundedSemaphore(MAX_CONNECTIONS)
    limiter = RateLimiter(RATE_LIMIT_REQUESTS, RATE_WINDOW_S)
    while True:
        try:
            connection, _ = listener.accept()
        except OSError as error:
            # Shutdown closes the listener. Any other error (EMFILE, ECONNABORTED) is transient, and ending here would leave a host that holds the lock and the socket but serves nobody.
            if listener.fileno() == -1:
                return
            log("accept failed, retrying: %s" % error)
            time.sleep(ACCEPT_RETRY_S)
            continue
        if not slots.acquire(blocking=False):
            connection.close()
            continue
        threading.Thread(target=serve_connection, args=(connection, state, link, hub, limiter, slots.release), daemon=True).start()


def read_exactly(stream, count):
    data = b""
    while len(data) < count:
        chunk = stream.read(count - len(data))
        if not chunk:
            raise StopHost()
        data += chunk
    return data


def skip(stream, count):
    while count > 0:
        chunk = stream.read(min(count, 65536))
        if not chunk:
            raise StopHost()
        count -= len(chunk)


def read_message(stream):
    """The next decoded message, None for a frame that is too large or not JSON. Raises StopHost at end of input."""
    (length,) = struct.unpack("=I", read_exactly(stream, 4))
    if length > MAX_MESSAGE_BYTES:
        if length > MAX_SKIPPED_BYTES:
            raise StopHost()
        skip(stream, length)
        log("skipped a message of %d bytes" % length)
        return None
    try:
        return json.loads(read_exactly(stream, length).decode("utf-8"))
    except (ValueError, RecursionError):
        log("skipped a message that is not JSON")
        return None


def send_message(stream, message):
    payload = json.dumps(message, separators=(",", ":")).encode("utf-8")
    stream.write(struct.pack("=I", len(payload)) + payload)
    stream.flush()


def take_event(message, hub):
    event = checked_event(message)
    if event is None:
        return
    if event["event"] == "tabs_off":
        forget_tab_caches()
    hub.publish(event)


def take_mode(message, state, hub):
    checked = checked_mode(message)
    if checked is None:
        return
    hub.publish(mode_event(*checked))
    try:
        state.apply(checked)
    except OSError as error:
        log("could not write the state file: %s" % error)


def serve(stdin, link, state, hub):
    link.say_ready()
    while True:
        message = read_message(stdin)
        verb = message.get("verb") if isinstance(message, dict) else None
        if verb == "reply":
            link.answered(message)
        elif verb == "event":
            take_event(message, hub)
        elif verb == "mode":
            take_mode(message, state, hub)


def raise_stop(_signal_number, _frame):
    raise StopHost()


def remove_quietly(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def main():
    try:
        paths = runtime_paths()
        pid = os.getpid()
        start = process_start(pid)
        os.makedirs(paths["folder"], mode=0o700, exist_ok=True)
        os.chmod(paths["folder"], 0o700)
    except (OSError, ValueError, IndexError) as error:
        log("cannot start: %s" % error)
        return 1
    signal.signal(signal.SIGTERM, raise_stop)
    signal.signal(signal.SIGINT, raise_stop)
    lock = None
    listener = None
    link = None
    hub = None
    try:
        lock = take_lock(paths["bridge.lock"], LOCK_WAIT_S)
        if lock is None:
            log("another bridge host owns the socket")
            return 1
        # Whatever is in the folder now belongs to a host that died: this one holds the lock.
        remove_quietly(paths["state.json"])
        prune_thumbnails(())
        prune_cache(favicon_dir(), ())
        listener = bind_socket(paths["bridge.sock"])
        state = BridgeState(paths["state.json"], pid, start)
        link = ExtensionLink(sys.stdout.buffer)
        hub = EventHub()
        threading.Thread(target=accept_loop, args=(listener, state, link, hub), daemon=True).start()
        serve(sys.stdin.buffer, link, state, hub)
    except StopHost:
        pass
    except BrokenPipeError:
        pass
    except OSError as error:
        log("cannot run: %s" % error)
        return 1
    finally:
        # A second signal during cleanup must not skip the delete.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        if hub is not None:
            hub.close()
        if link is not None:
            link.close()
        if listener is not None:
            listener.close()
            remove_quietly(paths["bridge.sock"])
            remove_quietly(paths["state.json"])
        if lock is not None:
            os.close(lock)
    return 0


if __name__ == "__main__":
    sys.exit(main())
