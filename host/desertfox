#!/usr/bin/env python3
"""Command line for the DesertFox bridge host. Python 3.9+, stdlib only.

  desertfox [--app firefox|thunderbird] <verb> ...

  desertfox run [--tab <id>] <command> [args...]   run one command in the focused Firefox window, or in a tab
  desertfox list [--json]             the commands the bridge allows, with their params
  desertfox state [--json]            the mode the bridge last saw
  desertfox theme <theme>             tell DesertFox which theme the desktop uses, or keep it for the next start while the bridge is down
  desertfox events                    print each event of the bridge as one JSON line until the bridge ends

The tab commands need `bridge_share_tabs` on in DesertFox, and never see a private window:

  desertfox tabs [--current] [--json]          the open tabs: id, window id, flags, title and address. With
                                               --current only the active tab of the last focused window, none
                                               when that window is private or a popup
  desertfox activate <id> [--preface <nonce>]  select the tab and focus its window, and put the nonce in front of the window title
  desertfox clear-preface <window id> [--preface <nonce>]
  desertfox close <id>
  desertfox capture [id...] [--json]           save thumbnails of the tabs (all loaded ones without ids) and print their paths

The mail reads need --app thunderbird and the DesertBird share settings, all off by default, beside `bridge`:

  desertfox --app thunderbird mail folders [--json]                      needs bridge_share_folders
  desertfox --app thunderbird mail list <folder id> [--limit N] [--unread] [--json]
                                                                         needs bridge_share_headers and bridge_share_folders
  desertfox --app thunderbird mail read <id> [--json]                    needs bridge_share_headers and bridge_share_bodies
  desertfox --app thunderbird mail attachments <id> [--json]             needs bridge_share_attachments
  desertfox --app thunderbird mail contacts <query> [--limit N] [--json] needs bridge_share_contacts and the addressBooks permission
                                       name and email only. Each word of the query has 2 characters or more, at most 5 words
                                       and 100 characters. The limit is 1 to 20 (20 without it).

The mail writes need --app thunderbird and `bridge`. They print a short line and never any mail text:

  desertfox --app thunderbird mail draft --to A [--to B ...] [--cc C ...] --subject S [--from EMAIL] [--reply-to ID] --body-file PATH|-
                                       save a draft, never send it. Needs bridge_allow_drafts. The body comes from the file
                                       or, with -, from stdin, never from the arguments, so the shell and `ps` never hold it.
                                       --to may be left out with --reply-to. --from must name one of your identities exactly
  desertfox --app thunderbird mail archive <id>...             archive the messages
  desertfox --app thunderbird mail trash <id>...               move the messages to their account's Trash
  desertfox --app thunderbird mail move <folder id> <id>...    move the messages, also needs bridge_share_folders
                                       Each act needs bridge_allow_actions and waits up to 70 s for a person to press y or n
                                       in Thunderbird. A second act while one waits is refused as busy.

Outside text (folder names and paths, from, to, subject, content type, the body, attachment names and types) prints only between
`<<<UNTRUSTED mail <what> nonce=<n>>>>` and `<<<END <n>>>>`, with a new random nonce for each print, so a reader can
tell where text from outside starts and ends. With --json the envelope lines wrap the JSON. A reply that dropped rows or cut the body says `truncated`.

`run` joins its arguments into the one command line the `:` line takes. A single argument is used as it is, so
`desertfox run "scroll.lines 3"` works. Several arguments are quoted for the line, so `desertfox run tab.switch "my tab"`
keeps the space.

It speaks to $XDG_RUNTIME_DIR/desertfox/bridge.sock for Firefox or $XDG_RUNTIME_DIR/desertbird/bridge.sock for
Thunderbird, one JSON line out and one line back, or for `events` the lines of the stream. Without --app it talks to
Firefox. `theme` is Firefox's alone. It prints plain text, errors to stderr. Exit codes: 0 done, 1 refused or failed, 2 bad usage, 3 the bridge is not running (`theme` instead keeps the name in theme.json and exits 0).
`-h` or `--help` after a verb prints the usage and sends nothing. `events` exits 0 when the bridge ends the stream, which it also does to a reader that falls
behind, so a caller that wants the stream for good runs it again.
"""
import fcntl
import json
import os
import re
import secrets
import shlex
import socket
import sys
import tempfile
import time
import unicodedata

EXIT_DONE = 0
EXIT_FAILED = 1
EXIT_USAGE = 2
EXIT_NO_BRIDGE = 3
# The host gives up on the extension after 10 s, so a reply always comes before this.
TIMEOUT_S = 15
# The host waits DRAFT_TIMEOUT_S, 40 s, for the add-on to save a draft.
DRAFT_TIMEOUT_S = 45
# The host waits ACT_TIMEOUT_S, 70 s, for the person who answers an act.
ACT_TIMEOUT_S = 75
# The host waits 10 s for the tab list, then up to 5 s for each of 64 tabs.
CAPTURE_TIMEOUT_S = 345
# The same range as MAX_MESSAGES_LIMIT in desertfox-bridge, checked here too so a bad value is a usage error.
MAX_MESSAGES_LIMIT = 200
# The same caps as MAX_BODY_BYTES and MAX_ACT_IDS in desertfox-bridge, checked here so the body is read no further than the cap.
MAX_BODY_BYTES = 64 * 1024
MAX_ACT_IDS = 50
# The same characters as BODY_CONTROL_PATTERN in desertfox-bridge, which refuses a body that holds one.
BODY_CONTROL_PATTERN = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
# Longer than the 3 s a starting host waits for the lock, so a host that is starting has bound its socket before this gives up.
LOCK_RETRY_S = 5
# The same shape as THEME_PATTERN in desertfox-bridge: the two scripts are standalone, and a test compares them.
THEME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}")

USAGE = """usage: desertfox [--app firefox|thunderbird] <verb> ...
       desertfox run [--tab <id>] <command> [args...]
       desertfox list [--json]
       desertfox state [--json]
       desertfox events
       desertfox theme <theme>
       desertfox tabs [--current] [--json]
       desertfox activate <id> [--preface <nonce>]
       desertfox clear-preface <window id> [--preface <nonce>]
       desertfox close <id>
       desertfox capture [id...] [--json]
       desertfox --app thunderbird mail folders [--json]           needs bridge_share_folders
       desertfox --app thunderbird mail list <folder id> [--limit N] [--unread] [--json]
                                                                   needs bridge_share_headers and bridge_share_folders
       desertfox --app thunderbird mail read <id> [--json]         needs bridge_share_headers and bridge_share_bodies
       desertfox --app thunderbird mail attachments <id> [--json]  needs bridge_share_attachments
       desertfox --app thunderbird mail contacts <query> [--limit N] [--json]
                                                                   needs bridge_share_contacts and the addressBooks permission
       desertfox --app thunderbird mail draft --to A [--to B ...] [--cc C ...] --subject S [--from EMAIL] [--reply-to ID] --body-file PATH|-
                                                                   needs bridge_allow_drafts; the body comes from the file or stdin (-)
       desertfox --app thunderbird mail archive <id>...            needs bridge_allow_actions
       desertfox --app thunderbird mail trash <id>...              needs bridge_allow_actions
       desertfox --app thunderbird mail move <folder id> <id>...   needs bridge_allow_actions and bridge_share_folders
       Every mail verb also needs bridge. An act waits up to 70 s for y or n in Thunderbird."""


class BridgeDown(Exception):
    pass


class NoListener(BridgeDown):
    """Nothing listens at the socket: the host is not running, or is about to start."""


# The runtime folder of each app's bridge host, the same names as APPS in desertfox-bridge.
APP_FOLDERS = {"firefox": "desertfox", "thunderbird": "desertbird"}
# The app whose bridge this run talks to, set once by main.
app = "firefox"


def bridge_folder(app_name=None):
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(runtime_dir):
        raise BridgeDown("XDG_RUNTIME_DIR is not set, so there is no bridge socket")
    return os.path.join(runtime_dir, APP_FOLDERS[app_name or app])


def socket_path(app_name=None):
    return os.path.join(bridge_folder(app_name), "bridge.sock")


def take_app(argv):
    """(the app named by a leading --app, the other words). The option counts only in front of the verb, so a run
    argument that looks like it is left alone."""
    if argv and argv[0] == "--app":
        if len(argv) < 2:
            raise Usage("--app needs a value: firefox or thunderbird")
        named, rest = argv[1], argv[2:]
    elif argv and argv[0].startswith("--app="):
        named, rest = argv[0][len("--app="):], argv[1:]
    else:
        return None, argv
    if named not in APP_FOLDERS:
        raise Usage("--app is firefox or thunderbird, not '%s'" % named)
    return named, rest


def request_line(request):
    """The request as one JSON line. Text goes as UTF-8, not as escapes, so a 64 KiB body of any script fits the host's
    request cap. A lone surrogate from an argument that is not UTF-8 has no UTF-8 form, so such a request goes escaped."""
    try:
        return json.dumps(request, ensure_ascii=False).encode("utf-8") + b"\n"
    except UnicodeEncodeError:
        return json.dumps(request).encode("utf-8") + b"\n"


def connected(request, timeout_s):
    """A new connection that has sent the request. Raises BridgeDown when nothing listens."""
    path = socket_path()
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(timeout_s)
        connection.connect(path)
        connection.sendall(request_line(request))
        return connection
    except (FileNotFoundError, ConnectionRefusedError):
        connection.close()
        raise NoListener("the bridge is not running (no listener at %s). Turn on the bridge setting in %s." % (path, "DesertBird" if app == "thunderbird" else "DesertFox"))
    except OSError as error:
        connection.close()
        raise BridgeDown("cannot talk to the bridge: %s" % error)


def read_line(connection, data):
    """(the next line, what follows it). The line is empty when the bridge closed the connection first."""
    while b"\n" not in data:
        chunk = connection.recv(65536)
        if not chunk:
            return b"", b""
        data += chunk
    line, _, rest = data.partition(b"\n")
    return line, rest


def decoded(line):
    try:
        reply = json.loads(line)
    except ValueError:
        raise BridgeDown("the bridge closed the connection without an answer")
    if not isinstance(reply, dict):
        raise BridgeDown("the bridge sent an answer that is not an object")
    return reply


def ask(request, timeout_s=TIMEOUT_S):
    """One request on a new connection and the decoded reply. Raises BridgeDown when nothing listens."""
    with connected(request, timeout_s) as connection:
        try:
            line, _ = read_line(connection, b"")
        except socket.timeout:
            raise BridgeDown("the bridge did not answer in time")
        except OSError as error:
            raise BridgeDown("cannot talk to the bridge: %s" % error)
    return decoded(line)


def command_line(words):
    return words[0] if len(words) == 1 else shlex.join(words)


def param_text(param):
    name = param.get("name", "?")
    values = param.get("values")
    if isinstance(values, list):
        name += "=" + "|".join(str(value) for value in values)
    optional = "default" in param or param.get("optional") is True or "when" in param
    return "[%s]" % name if optional else name


def list_line(command):
    word = command.get("name") or command.get("id", "")
    params = " ".join(param_text(param) for param in command.get("params", []))
    return "\t".join((word, command.get("id", ""), command.get("label", ""), params))


def fail(message, code=EXIT_FAILED):
    sys.stderr.write("desertfox: %s\n" % message)
    return code


class Usage(Exception):
    pass


def whole_number(text, what):
    try:
        return int(text)
    except ValueError:
        raise Usage("%s is a whole number, not '%s'" % (what, text))


def take_option(words, name):
    """(value, the other words) for `--name value` or `--name=value` anywhere in the words, with value None when it is absent."""
    value = None
    rest = []
    index = 0
    while index < len(words):
        word = words[index]
        if word == name:
            if index + 1 >= len(words):
                raise Usage("%s needs a value" % name)
            value = words[index + 1]
            index += 2
            continue
        if word.startswith(name + "="):
            value = word[len(name) + 1:]
        else:
            rest.append(word)
        index += 1
    return value, rest


def do_run(words):
    # `--tab` is read only in front of the command, so a command argument that looks like it is left alone.
    fields = {}
    if words and (words[0] == "--tab" or words[0].startswith("--tab=")):
        if words[0] == "--tab":
            if len(words) < 2:
                raise Usage("--tab needs a tab id")
            fields["tab_id"], words = whole_number(words[1], "the tab id"), words[2:]
        else:
            fields["tab_id"], words = whole_number(words[0][len("--tab="):], "the tab id"), words[1:]
    if not words:
        raise Usage("run needs a command")
    reply = ask(dict(fields, verb="run", command=command_line(words)))
    if reply.get("ok") is True:
        if reply.get("message"):
            print(reply["message"])
        return EXIT_DONE
    return fail(reply.get("message") or "the command was refused")


def do_list(flags):
    reply = ask({"verb": "list"})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list its commands")
    commands = reply.get("commands", [])
    if flags == ["--json"]:
        print(json.dumps(commands, indent=2))
    else:
        for command in commands:
            print(list_line(command))
    return EXIT_DONE


def tab_line(tab):
    flags = "".join(letter if tab.get(name) else "-" for letter, name in (("a", "active"), ("s", "audible"), ("d", "discarded"), ("p", "pinned")))
    return "\t".join((str(tab.get("tab_id")), str(tab.get("window_id")), flags, tab.get("title", ""), tab.get("url", "")))


def do_tabs(flags):
    unknown = [flag for flag in flags if flag not in ("--json", "--current")]
    if unknown or len(set(flags)) != len(flags):
        raise Usage("tabs takes only --current and --json")
    reply = ask({"verb": "tabs", **({"current": True} if "--current" in flags else {})})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list the tabs")
    tabs = reply.get("tabs", [])
    if "--json" in flags:
        print(json.dumps(tabs, indent=2))
    else:
        for tab in tabs:
            print(tab_line(tab))
    return EXIT_DONE


def finished(reply, fields=()):
    """Exit status for a tab verb: the named reply fields go to stdout as one JSON object, a refusal to stderr."""
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge refused")
    if fields:
        print(json.dumps({name: reply[name] for name in fields if name in reply}))
    return EXIT_DONE


def do_activate(words):
    preface, rest = take_option(words, "--preface")
    if len(rest) != 1:
        raise Usage("activate takes one tab id")
    request = {"verb": "activate", "tab_id": whole_number(rest[0], "the tab id")}
    if preface is not None:
        request["preface"] = preface
    return finished(ask(request), ("window_id", "focused", "preface_set"))


def do_clear_preface(words):
    preface, rest = take_option(words, "--preface")
    if len(rest) != 1:
        raise Usage("clear-preface takes one window id")
    request = {"verb": "clear_preface", "window_id": whole_number(rest[0], "the window id")}
    if preface is not None:
        request["preface"] = preface
    return finished(ask(request), ("cleared",))


def do_close(words):
    if len(words) != 1:
        raise Usage("close takes one tab id")
    return finished(ask({"verb": "close", "tab_id": whole_number(words[0], "the tab id")}))


def do_capture(words):
    as_json = "--json" in words
    ids = [whole_number(word, "a tab id") for word in words if word != "--json"]
    reply = ask({"verb": "capture", **({"tab_ids": ids} if ids else {})}, CAPTURE_TIMEOUT_S)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not capture")
    results = reply.get("results", [])
    if as_json:
        print(json.dumps(results, indent=2))
    else:
        for result in results:
            print("\t".join((str(result.get("tab_id")), result.get("thumbnail", "") if result.get("ok") else "failed: " + str(result.get("error", "")))))
    return EXIT_DONE if all(result.get("ok") for result in results) else EXIT_FAILED


def print_untrusted(what, text):
    """Prints text from outside between nonce lines. The nonce is drawn after the text is known and drawn again while
    the text holds it, so no line of the text can close the envelope, a guessed or an old END line included."""
    nonce = secrets.token_hex(16)
    while nonce in text:
        nonce = secrets.token_hex(16)
    if text and not text.endswith("\n"):
        text += "\n"
    sys.stdout.write("<<<UNTRUSTED mail %s nonce=%s>>>\n%s<<<END %s>>>\n" % (what, nonce, text, nonce))


def one_line(value):
    """A field for a tab separated row. The add-on strips control characters already, so this only keeps a row whole if
    one gets through."""
    return "".join(" " if ord(char) < 32 or 127 <= ord(char) < 160 else char for char in str(value))


def note_truncated(reply):
    if reply.get("truncated") is True:
        sys.stderr.write("desertfox: truncated: the reply left out rows to stay under its size cap\n")


def without_ok(reply):
    return {name: value for name, value in reply.items() if name != "ok"}


def mail_folders(words):
    if words not in ([], ["--json"]):
        raise Usage("mail folders takes only --json")
    reply = ask({"verb": "folders"})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list the folders")
    # Feed titles, newsgroups and shared IMAP folders let third parties name folders, so the list is outside text too.
    if words:
        print_untrusted("folders", json.dumps(without_ok(reply), indent=2))
        return EXIT_DONE
    rows = ("\t".join(one_line(folder.get(name, "")) for name in ("id", "unread", "total", "account", "path")) + "\n" for folder in reply.get("folders", []))
    print_untrusted("folders", "".join(rows))
    note_truncated(reply)
    return EXIT_DONE


def message_row(message):
    flags = "".join(letter if message.get(name) else "-" for letter, name in (("r", "read"), ("f", "flagged")))
    return "\t".join(one_line(value) for value in (message.get("id", ""), message.get("date", ""), flags, message.get("from", ""), message.get("subject", "")))


def mail_list(words):
    limit, words = take_option(words, "--limit")
    flags = [word for word in words if word in ("--unread", "--json")]
    folder_ids = [word for word in words if word not in flags]
    if len(folder_ids) != 1 or len(set(flags)) != len(flags):
        raise Usage("mail list takes one folder id, then --limit N, --unread and --json")
    request = {"verb": "messages", "folder": folder_ids[0]}
    if limit is not None:
        request["limit"] = whole_number(limit, "the limit")
        if not 1 <= request["limit"] <= MAX_MESSAGES_LIMIT:
            raise Usage("the limit is from 1 to %d" % MAX_MESSAGES_LIMIT)
    if "--unread" in flags:
        request["unread_only"] = True
    reply = ask(request)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list the messages")
    if "--json" in flags:
        print_untrusted("list", json.dumps(without_ok(reply), indent=2))
        return EXIT_DONE
    print_untrusted("list", "".join(message_row(message) + "\n" for message in reply.get("messages", [])))
    note_truncated(reply)
    return EXIT_DONE


def taken_message_id(words, what):
    """(the message id, whether --json follows it)."""
    as_json = words[1:] == ["--json"]
    if len(words) != (2 if as_json else 1):
        raise Usage("mail %s takes one message id and --json" % what)
    return whole_number(words[0], "the message id"), as_json


def mail_read(words):
    message_id, as_json = taken_message_id(words, "read")
    reply = ask({"verb": "message", "id": message_id})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not read the message")
    message = reply.get("message") or {}
    if as_json:
        print_untrusted("body id=%d" % message_id, json.dumps(message, indent=2))
        return EXIT_DONE
    for name in ("id", "date", "html_stripped", "truncated"):
        value = message.get(name, "")
        print("%s: %s" % (name, json.dumps(value) if isinstance(value, bool) else one_line(value)))
    # content_type is the sender's own header, so it goes inside with the other sender text.
    to = message.get("to")
    headers = "".join("%s: %s\n" % (name, one_line(value)) for name, value in (
        ("from", message.get("from", "")),
        ("to", ", ".join(map(str, to)) if isinstance(to, list) else ""),
        ("subject", message.get("subject", "")),
        ("content_type", message.get("content_type", "")),
    ))
    print_untrusted("body id=%d" % message_id, headers + "\n" + str(message.get("body", "")))
    return EXIT_DONE


def mail_attachments(words):
    message_id, as_json = taken_message_id(words, "attachments")
    reply = ask({"verb": "attachments", "id": message_id})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list the attachments")
    if as_json:
        print_untrusted("attachments id=%d" % message_id, json.dumps(without_ok(reply), indent=2))
        return EXIT_DONE
    rows = ("\t".join(one_line(part.get(name, "")) for name in ("part", "size", "content_type", "name")) + "\n" for part in reply.get("attachments", []))
    print_untrusted("attachments id=%d" % message_id, "".join(rows))
    note_truncated(reply)
    return EXIT_DONE


MAX_CONTACTS_LIMIT = 20
MIN_CONTACTS_WORD_CHARS = 2
MAX_CONTACTS_WORDS = 5
MAX_CONTACTS_QUERY_UNITS = 100


def contacts_query(words):
    """The query the words make, checked by the DesertBird rules. The add-on stays the authority and checks again."""
    query = " ".join(words)
    if any(ord(char) < 32 or 127 <= ord(char) < 160 or unicodedata.category(char) in ("Cf", "Zl", "Zp", "Cs") for char in query):
        raise Usage("the query holds a control character")
    if len(query.encode("utf-16-le")) // 2 > MAX_CONTACTS_QUERY_UNITS:
        raise Usage("the query is at most %d characters" % MAX_CONTACTS_QUERY_UNITS)
    query_words = query.split()
    if not query_words:
        raise Usage("mail contacts takes a query")
    if any(len(word) < MIN_CONTACTS_WORD_CHARS for word in query_words):
        raise Usage("each word of the query needs at least %d characters" % MIN_CONTACTS_WORD_CHARS)
    if len(query_words) > MAX_CONTACTS_WORDS:
        raise Usage("the query is at most %d words" % MAX_CONTACTS_WORDS)
    return " ".join(query_words)


def contacts_row(contact):
    """Name and email only, whatever else the reply holds."""
    emails = contact.get("emails")
    return {"name": contact.get("name", ""), "emails": [str(email) for email in emails] if isinstance(emails, list) else []}


def mail_contacts(words):
    limit, words = take_option(words, "--limit")
    as_json = "--json" in words
    query = contacts_query([word for word in words if word != "--json"])
    request = {"verb": "contacts", "query": query}
    if limit is not None:
        request["limit"] = whole_number(limit, "the limit")
        if not 1 <= request["limit"] <= MAX_CONTACTS_LIMIT:
            raise Usage("the limit is from 1 to %d" % MAX_CONTACTS_LIMIT)
    reply = ask(request)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not search the contacts")
    rows = [contacts_row(contact) for contact in reply.get("contacts", []) if isinstance(contact, dict)]
    if as_json:
        print_untrusted("contacts", json.dumps({"contacts": rows, "untrusted": True, "truncated": reply.get("truncated") is True}, indent=2))
        return EXIT_DONE
    print_untrusted("contacts", "".join("\t".join((one_line(row["name"]), ", ".join(one_line(email) for email in row["emails"]))) + "\n" for row in rows))
    note_truncated(reply)
    return EXIT_DONE


def take_repeated_option(words, name):
    """(every value of `--name value` or `--name=value` in the words, the other words)."""
    values = []
    while True:
        value, words = take_option_once(words, name)
        if value is None:
            return values, words
        values.append(value)


def take_option_once(words, name):
    """(value, the other words) for the first `--name value` or `--name=value`, with value None when it is absent."""
    for index, word in enumerate(words):
        if word == name:
            if index + 1 >= len(words):
                raise Usage("%s needs a value" % name)
            return words[index + 1], words[:index] + words[index + 2:]
        if word.startswith(name + "="):
            return word[len(name) + 1:], words[:index] + words[index + 1:]
    return None, words


def take_single_option(words, name):
    values, words = take_repeated_option(words, name)
    if len(values) > 1:
        raise Usage("%s is given once" % name)
    return (values[0] if values else None), words


def read_body(path):
    """The body text from the file at `path`, or from stdin for -. Read no further than one byte past the cap."""
    if path == "-":
        data = sys.stdin.buffer.read(MAX_BODY_BYTES + 1)
    else:
        with open(path, "rb") as body_file:
            data = body_file.read(MAX_BODY_BYTES + 1)
    if len(data) > MAX_BODY_BYTES:
        raise Usage("the body is over %d bytes" % MAX_BODY_BYTES)
    try:
        body = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Usage("the body is not UTF-8")
    if BODY_CONTROL_PATTERN.search(body):
        raise Usage("the body holds a control character other than tab, newline and carriage return")
    return body


def mail_draft(words):
    to, words = take_repeated_option(words, "--to")
    cc, words = take_repeated_option(words, "--cc")
    subject, words = take_single_option(words, "--subject")
    sender, words = take_single_option(words, "--from")
    reply_to, words = take_single_option(words, "--reply-to")
    body_path, words = take_single_option(words, "--body-file")
    if words:
        raise Usage("mail draft takes no '%s'; the body comes from --body-file PATH or --body-file -" % words[0])
    if subject is None or body_path is None:
        raise Usage("mail draft needs --subject and --body-file")
    if not to and reply_to is None:
        raise Usage("mail draft needs --to, unless it is a reply with --reply-to")
    request = {"verb": "draft", "to": to, "subject": subject}
    if cc:
        request["cc"] = cc
    if sender is not None:
        request["from"] = sender
    if reply_to is not None:
        request["reply_to_id"] = whole_number(reply_to, "the message id after --reply-to")
    try:
        request["body"] = read_body(body_path)
    except OSError as error:
        return fail("cannot read the body: %s" % error.strerror)
    reply = ask(request, DRAFT_TIMEOUT_S)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not save the draft")
    print("draft saved")
    return EXIT_DONE


# The confirmation line of each act, filled with the count and "message" or "messages".
ACT_DONE = {"archive": "archived %d %s", "trash": "moved %d %s to Trash", "move": "moved %d %s"}


def mail_act(action, words):
    folder = None
    if action == "move":
        if not words:
            raise Usage("mail move takes a folder id, then message ids")
        folder, words = words[0], words[1:]
    ids = [whole_number(word, "a message id") for word in words]
    if not 1 <= len(ids) <= MAX_ACT_IDS or len(set(ids)) != len(ids):
        raise Usage("mail %s takes 1 to %d different message ids" % (action, MAX_ACT_IDS))
    request = {"verb": "act", "action": action, "ids": ids}
    if folder is not None:
        request["folder"] = folder
    reply = ask(request, ACT_TIMEOUT_S)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not %s the messages" % action)
    count = reply.get("count")
    count = count if isinstance(count, int) else len(ids)
    print(ACT_DONE[action] % (count, "message" if count == 1 else "messages"))
    return EXIT_DONE


def do_mail(words):
    if app != "thunderbird":
        raise Usage("mail needs --app thunderbird")
    verb = words[0] if words else None
    if verb in ACT_DONE:
        return mail_act(verb, words[1:])
    handler = {"folders": mail_folders, "list": mail_list, "read": mail_read, "attachments": mail_attachments, "contacts": mail_contacts, "draft": mail_draft}.get(verb)
    if not handler:
        raise Usage("mail takes folders, list, read, attachments, contacts, draft, archive, trash or move")
    return handler(words[1:])


def write_atomically(path, content):
    descriptor, temp_path = tempfile.mkstemp(prefix=".state.", suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temp_file:
            json.dump(content, temp_file, separators=(",", ":"))
        os.replace(temp_path, path)
    except BaseException:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def keep_theme_if_no_host(theme):
    """True after writing theme.json, False when a host holds bridge.lock. The host loads theme.json only after it takes
    the lock, so a write under the lock is never lost to a host that starts at the same moment."""
    folder = bridge_folder()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    lock = os.open(os.path.join(folder, "bridge.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        write_atomically(os.path.join(folder, "theme.json"), {"theme": theme})
        return True
    finally:
        os.close(lock)


def do_theme(words):
    if app != "firefox":
        raise Usage("theme needs --app firefox")
    if len(words) != 1:
        raise Usage("theme takes one theme name")
    theme = words[0]
    if not THEME_PATTERN.fullmatch(theme):
        raise Usage("a theme name starts with a letter or digit, then letters, digits, _ and -, at most 64 characters in all")
    request = {"verb": "theme", "theme": theme}
    deadline = time.monotonic() + LOCK_RETRY_S
    while True:
        try:
            return finished(ask(request))
        except NoListener:
            # No host: keep the name for the one the browser starts next. A held lock means a host is starting, so ask again.
            try:
                if keep_theme_if_no_host(theme):
                    return EXIT_DONE
            except OSError as error:
                raise BridgeDown("the bridge is not running and the theme could not be kept: %s" % error)
            if time.monotonic() >= deadline:
                raise BridgeDown("a bridge host holds the lock but does not answer")
            time.sleep(0.05)


def do_state(flags):
    reply = ask({"verb": "state"})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not give its state")
    print(json.dumps(reply.get("state"), indent=2 if flags == ["--json"] else None))
    return EXIT_DONE


def do_events(words):
    """Prints each event line as it comes, flushed, so a reader through a pipe sees it at once."""
    if words:
        raise Usage("events takes no arguments")
    # Events can be minutes apart, so the stream waits with no timeout. The bridge ends it when the host stops.
    with connected({"verb": "subscribe"}, TIMEOUT_S) as connection:
        try:
            line, data = read_line(connection, b"")
            reply = decoded(line)
            if reply.get("ok") is not True:
                return fail(reply.get("message") or "the bridge refused the stream")
            connection.settimeout(None)
            while True:
                line, data = read_line(connection, data)
                if not line:
                    return EXIT_DONE
                sys.stdout.write(line.decode("utf-8") + "\n")
                sys.stdout.flush()
        except BrokenPipeError:
            # The reader left, as `desertfox events | head -1` does. Stdout goes to /dev/null so the flush at exit stays quiet.
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
            return EXIT_DONE
        except KeyboardInterrupt:
            return EXIT_DONE
        except socket.timeout:
            raise BridgeDown("the bridge did not answer in time")
        except OSError as error:
            raise BridgeDown("cannot talk to the bridge: %s" % error)


def main(argv):
    global app
    try:
        named_app, argv = take_app(argv)
    except Usage as error:
        return fail("%s\n%s" % (error, USAGE), EXIT_USAGE)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return EXIT_DONE if argv else EXIT_USAGE
    verb, rest = argv[0], argv[1:]
    if rest[:1] in (["-h"], ["--help"]) or (verb == "mail" and rest[1:2] in (["-h"], ["--help"])):
        print(USAGE)
        return EXIT_DONE
    try:
        # Desktop calls written before Thunderbird pass no --app, so no --app always means Firefox.
        app = named_app or "firefox"
        if verb == "run":
            return do_run(rest)
        if verb in ("list", "state"):
            if rest not in ([], ["--json"]):
                return fail("%s takes only --json\n%s" % (verb, USAGE), EXIT_USAGE)
            return {"list": do_list, "state": do_state}[verb](rest)
        handler = {"tabs": do_tabs, "events": do_events, "theme": do_theme, "activate": do_activate, "clear-preface": do_clear_preface, "close": do_close, "capture": do_capture, "mail": do_mail}.get(verb)
        if handler:
            return handler(rest)
    except Usage as error:
        return fail("%s\n%s" % (error, USAGE), EXIT_USAGE)
    except BridgeDown as error:
        return fail(str(error), EXIT_NO_BRIDGE)
    return fail("unknown command '%s'\n%s" % (verb, USAGE), EXIT_USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
