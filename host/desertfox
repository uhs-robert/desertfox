#!/usr/bin/env python3
"""Command line for the DesertFox bridge host. Python 3.9+, stdlib only.

  desertfox run [--tab <id>] <command> [args...]   run one command in the focused Firefox window, or in a tab
  desertfox list [--json]             the commands the bridge allows, with their params
  desertfox state [--json]            the mode the bridge last saw
  desertfox theme <palette>           tell DesertFox which palette the desktop uses
  desertfox events                    print each event of the bridge as one JSON line until the bridge ends

The tab commands need `bridge_share_tabs` on in DesertFox, and never see a private window:

  desertfox tabs [--current] [--json]          the open tabs: id, window id, flags, title and address. With
                                               --current only the active tab of the last focused window, none
                                               when that window is private or a popup
  desertfox activate <id> [--preface <nonce>]  select the tab and focus its window, and put the nonce in front of the window title
  desertfox clear-preface <window id> [--preface <nonce>]
  desertfox close <id>
  desertfox capture [id...] [--json]           save thumbnails of the tabs (all loaded ones without ids) and print their paths

`run` joins its arguments into the one command line the `:` line takes. A single argument is used as it is, so
`desertfox run "scroll.lines 3"` works. Several arguments are quoted for the line, so `desertfox run tab.switch "my tab"`
keeps the space.

It speaks to $XDG_RUNTIME_DIR/desertfox/bridge.sock, one JSON line out and one line back, or for `events` the lines
of the stream. It prints plain text, errors to stderr. Exit codes: 0 done, 1 refused or failed, 2 bad usage, 3 the
bridge is not running. `events` exits 0 when the bridge ends the stream, which it also does to a reader that falls
behind, so a caller that wants the stream for good runs it again.
"""
import json
import os
import shlex
import socket
import sys

EXIT_DONE = 0
EXIT_FAILED = 1
EXIT_USAGE = 2
EXIT_NO_BRIDGE = 3
# The host gives up on the extension after 10 s, so a reply always comes before this.
TIMEOUT_S = 15
# The host waits 10 s for the tab list, then up to 5 s for each of 64 tabs.
CAPTURE_TIMEOUT_S = 345

USAGE = """usage: desertfox run [--tab <id>] <command> [args...]
       desertfox list [--json]
       desertfox state [--json]
       desertfox events
       desertfox theme <palette>
       desertfox tabs [--current] [--json]
       desertfox activate <id> [--preface <nonce>]
       desertfox clear-preface <window id> [--preface <nonce>]
       desertfox close <id>
       desertfox capture [id...] [--json]"""


class BridgeDown(Exception):
    pass


def socket_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(runtime_dir):
        raise BridgeDown("XDG_RUNTIME_DIR is not set, so there is no bridge socket")
    return os.path.join(runtime_dir, "desertfox", "bridge.sock")


def connected(request, timeout_s):
    """A new connection that has sent the request. Raises BridgeDown when nothing listens."""
    path = socket_path()
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(timeout_s)
        connection.connect(path)
        connection.sendall(json.dumps(request).encode("utf-8") + b"\n")
        return connection
    except (FileNotFoundError, ConnectionRefusedError):
        connection.close()
        raise BridgeDown("the bridge is not running (no listener at %s). Turn on the bridge setting in DesertFox." % path)
    except OSError as error:
        connection.close()
        raise BridgeDown("cannot talk to the bridge: %s" % error)


def read_line(connection, data):
    """(the next line, what follows it). The line is empty when the bridge closed the connection first."""
    while b"\n" not in data:
        chunk = connection.recv(65536)
        if not chunk:
            return b"", b""
        data += chunk
    line, _, rest = data.partition(b"\n")
    return line, rest


def decoded(line):
    try:
        reply = json.loads(line)
    except ValueError:
        raise BridgeDown("the bridge closed the connection without an answer")
    if not isinstance(reply, dict):
        raise BridgeDown("the bridge sent an answer that is not an object")
    return reply


def ask(request, timeout_s=TIMEOUT_S):
    """One request on a new connection and the decoded reply. Raises BridgeDown when nothing listens."""
    with connected(request, timeout_s) as connection:
        try:
            line, _ = read_line(connection, b"")
        except socket.timeout:
            raise BridgeDown("the bridge did not answer in time")
        except OSError as error:
            raise BridgeDown("cannot talk to the bridge: %s" % error)
    return decoded(line)


def command_line(words):
    return words[0] if len(words) == 1 else shlex.join(words)


def param_text(param):
    name = param.get("name", "?")
    values = param.get("values")
    if isinstance(values, list):
        name += "=" + "|".join(str(value) for value in values)
    optional = "default" in param or param.get("optional") is True or "when" in param
    return "[%s]" % name if optional else name


def list_line(command):
    word = command.get("name") or command.get("id", "")
    params = " ".join(param_text(param) for param in command.get("params", []))
    return "\t".join((word, command.get("id", ""), command.get("label", ""), params))


def fail(message, code=EXIT_FAILED):
    sys.stderr.write("desertfox: %s\n" % message)
    return code


class Usage(Exception):
    pass


def whole_number(text, what):
    try:
        return int(text)
    except ValueError:
        raise Usage("%s is a whole number, not '%s'" % (what, text))


def take_option(words, name):
    """(value, the other words) for `--name value` or `--name=value` anywhere in the words, with value None when it is absent."""
    value = None
    rest = []
    index = 0
    while index < len(words):
        word = words[index]
        if word == name:
            if index + 1 >= len(words):
                raise Usage("%s needs a value" % name)
            value = words[index + 1]
            index += 2
            continue
        if word.startswith(name + "="):
            value = word[len(name) + 1:]
        else:
            rest.append(word)
        index += 1
    return value, rest


def do_run(words):
    # `--tab` is read only in front of the command, so a command argument that looks like it is left alone.
    fields = {}
    if words and (words[0] == "--tab" or words[0].startswith("--tab=")):
        if words[0] == "--tab":
            if len(words) < 2:
                raise Usage("--tab needs a tab id")
            fields["tab_id"], words = whole_number(words[1], "the tab id"), words[2:]
        else:
            fields["tab_id"], words = whole_number(words[0][len("--tab="):], "the tab id"), words[1:]
    if not words:
        raise Usage("run needs a command")
    reply = ask(dict(fields, verb="run", command=command_line(words)))
    if reply.get("ok") is True:
        if reply.get("message"):
            print(reply["message"])
        return EXIT_DONE
    return fail(reply.get("message") or "the command was refused")


def do_list(flags):
    reply = ask({"verb": "list"})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list its commands")
    commands = reply.get("commands", [])
    if flags == ["--json"]:
        print(json.dumps(commands, indent=2))
    else:
        for command in commands:
            print(list_line(command))
    return EXIT_DONE


def tab_line(tab):
    flags = "".join(letter if tab.get(name) else "-" for letter, name in (("a", "active"), ("s", "audible"), ("d", "discarded"), ("p", "pinned")))
    return "\t".join((str(tab.get("tab_id")), str(tab.get("window_id")), flags, tab.get("title", ""), tab.get("url", "")))


def do_tabs(flags):
    unknown = [flag for flag in flags if flag not in ("--json", "--current")]
    if unknown or len(set(flags)) != len(flags):
        raise Usage("tabs takes only --current and --json")
    reply = ask({"verb": "tabs", **({"current": True} if "--current" in flags else {})})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not list the tabs")
    tabs = reply.get("tabs", [])
    if "--json" in flags:
        print(json.dumps(tabs, indent=2))
    else:
        for tab in tabs:
            print(tab_line(tab))
    return EXIT_DONE


def finished(reply, fields=()):
    """Exit status for a tab verb: the named reply fields go to stdout as one JSON object, a refusal to stderr."""
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge refused")
    if fields:
        print(json.dumps({name: reply[name] for name in fields if name in reply}))
    return EXIT_DONE


def do_activate(words):
    preface, rest = take_option(words, "--preface")
    if len(rest) != 1:
        raise Usage("activate takes one tab id")
    request = {"verb": "activate", "tab_id": whole_number(rest[0], "the tab id")}
    if preface is not None:
        request["preface"] = preface
    return finished(ask(request), ("window_id", "focused", "preface_set"))


def do_clear_preface(words):
    preface, rest = take_option(words, "--preface")
    if len(rest) != 1:
        raise Usage("clear-preface takes one window id")
    request = {"verb": "clear_preface", "window_id": whole_number(rest[0], "the window id")}
    if preface is not None:
        request["preface"] = preface
    return finished(ask(request), ("cleared",))


def do_close(words):
    if len(words) != 1:
        raise Usage("close takes one tab id")
    return finished(ask({"verb": "close", "tab_id": whole_number(words[0], "the tab id")}))


def do_capture(words):
    as_json = "--json" in words
    ids = [whole_number(word, "a tab id") for word in words if word != "--json"]
    reply = ask({"verb": "capture", **({"tab_ids": ids} if ids else {})}, CAPTURE_TIMEOUT_S)
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not capture")
    results = reply.get("results", [])
    if as_json:
        print(json.dumps(results, indent=2))
    else:
        for result in results:
            print("\t".join((str(result.get("tab_id")), result.get("thumbnail", "") if result.get("ok") else "failed: " + str(result.get("error", "")))))
    return EXIT_DONE if all(result.get("ok") for result in results) else EXIT_FAILED


def do_theme(words):
    if len(words) != 1:
        raise Usage("theme takes one palette name")
    return finished(ask({"verb": "theme", "palette": words[0]}))


def do_state(flags):
    reply = ask({"verb": "state"})
    if reply.get("ok") is not True:
        return fail(reply.get("message") or "the bridge did not give its state")
    print(json.dumps(reply.get("state"), indent=2 if flags == ["--json"] else None))
    return EXIT_DONE


def do_events(words):
    """Prints each event line as it comes, flushed, so a reader through a pipe sees it at once."""
    if words:
        raise Usage("events takes no arguments")
    # Events can be minutes apart, so the stream waits with no timeout. The bridge ends it when the host stops.
    with connected({"verb": "subscribe"}, TIMEOUT_S) as connection:
        try:
            line, data = read_line(connection, b"")
            reply = decoded(line)
            if reply.get("ok") is not True:
                return fail(reply.get("message") or "the bridge refused the stream")
            connection.settimeout(None)
            while True:
                line, data = read_line(connection, data)
                if not line:
                    return EXIT_DONE
                sys.stdout.write(line.decode("utf-8") + "\n")
                sys.stdout.flush()
        except BrokenPipeError:
            # The reader left, as `desertfox events | head -1` does. Stdout goes to /dev/null so the flush at exit stays quiet.
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
            return EXIT_DONE
        except KeyboardInterrupt:
            return EXIT_DONE
        except socket.timeout:
            raise BridgeDown("the bridge did not answer in time")
        except OSError as error:
            raise BridgeDown("cannot talk to the bridge: %s" % error)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return EXIT_DONE if argv else EXIT_USAGE
    verb, rest = argv[0], argv[1:]
    try:
        if verb == "run":
            return do_run(rest)
        if verb in ("list", "state"):
            if rest not in ([], ["--json"]):
                return fail("%s takes only --json\n%s" % (verb, USAGE), EXIT_USAGE)
            return {"list": do_list, "state": do_state}[verb](rest)
        handler = {"tabs": do_tabs, "events": do_events, "theme": do_theme, "activate": do_activate, "clear-preface": do_clear_preface, "close": do_close, "capture": do_capture}.get(verb)
        if handler:
            return handler(rest)
    except Usage as error:
        return fail("%s\n%s" % (error, USAGE), EXIT_USAGE)
    except BridgeDown as error:
        return fail(str(error), EXIT_NO_BRIDGE)
    return fail("unknown command '%s'\n%s" % (verb, USAGE), EXIT_USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
