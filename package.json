{
  "name": "desertfox",
  "version": "0.1.21",
  "private": true,
  "description": "Keyboard-first Firefox extension built around one command registry.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "docs:gen": "node --no-warnings tools/gen-keymap-docs.ts --write",
    "docs:check": "node --no-warnings tools/gen-keymap-docs.ts --check",
    "themes:copy": "node --no-warnings tools/copy_oasis_css.ts",
    "themes:write": "node --no-warnings tools/build_themes.ts --write",
    "themes:check": "node --no-warnings tools/build_themes.ts --check",
    "defaults:write": "node --no-warnings tools/build_default_settings.ts --write",
    "defaults:check": "node --no-warnings tools/build_default_settings.ts --check",
    "completion:write": "node --no-warnings tools/build_setting_completion.ts --write",
    "completion:check": "node --no-warnings tools/build_setting_completion.ts --check",
    "rename:check": "node --no-warnings tools/rename_to_desertfox.mjs --check",
    "test": "npm run --silent rename:check && npm run --silent docs:check && npm run --silent themes:check && npm run --silent defaults:check && npm run --silent completion:check && node --test --test-timeout=30000 --no-warnings \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.0"
  }
}
